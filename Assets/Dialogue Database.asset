    - id: 4
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Oh! Maybe that\u2019s not useful now\u2026 Maybe you\u2019re not
          feeling Anger"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Oh! Igual eso no es \xFAtil ahora... Puede ser que no estes sintiendo
          Ira"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Oh! Vielleicht ist das jetzt nicht n\xFCtzlich... Vielleicht f\xFChlst
          du keinen Zorn"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "No voi! Siit\xE4 ei nyt ehk\xE4 ole apua\u2026 Ehk\xE4 olosi ei ole
          Suuttumus"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 57
      isRoot: 0
      isGroup: 0
      nodeColor: 
