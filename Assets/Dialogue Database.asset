        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: When someone is shunned from society because of the way they are or
          look or live their lives, I believe they are being treated unfairly
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Cuando alguien es rechazado por la sociedad por su forma de ser,
          su aspecto o su estilo de vida, creo que est\xE1 siendo tratado injustamente."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Wenn jemand aufgrund seiner Art, seines Aussehens oder seiner Lebensweise
          von der Gesellschaft ausgegrenzt wird, dann wird er meiner Meinung nach
          unfair behandelt.
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Jos yhteiskunta vieroksuu jotakuta sen vuoksi, millainen h\xE4n on
          tai milt\xE4 h\xE4n n\xE4ytt\xE4\xE4 tai miten h\xE4n el\xE4\xE4 el\xE4m\xE4ns\xE4,
          minusta h\xE4nt\xE4 kohdellaan ep\xE4reilusti"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 45
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
