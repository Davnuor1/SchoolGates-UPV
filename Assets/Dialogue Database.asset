        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: No puedo superar este camino solo, podrias guiarme?
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ich kann diesen Weg nicht allein gehen. Kannst du mich f\xFChren?"
        type: 4
