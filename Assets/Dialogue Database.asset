        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "They are being kind to me\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
