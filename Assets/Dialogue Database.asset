    - id: 1
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I have inadvertently left one of my windows open and my beloved Parrot
          has flown out and now I cannot find him anymore! I am very worried because
          he\u2019s never been outside, and I am afraid he will die if I don\u2019t
          find him soon! Can you please help me?"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1Me he dejado sin querer una de las ventanas abiertas y mi querido
          loro ha salido volando y ahora ya no lo encuentro! Estoy muy preocupada
          porque nunca ha estado fuera, \xA1y tengo miedo de que muera si no lo encuentro
          pronto! \xBFPuedes ayudarme, por favor?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ich habe versehentlich eines meiner Fenster offen gelassen und mein
          geliebter Papagei ist hinausgeflogen und jetzt kann ich ihn nicht mehr
          finden! Ich bin sehr besorgt, weil er noch nie drau\xDFen war und ich bef\xFCrchte,
          er wird sterben, wenn ich ihn nicht bald finde! K\xF6nntest Du mir bitte
          helfen?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ho inavvertitamente lasciato una delle mie finestre aperta ed il
          mio amato Pappagallo \xE8 volato via ed ora non lo trovo pi\xF9! Sono molto
          preoccupata perch\xE9 non \xE8 mai uscito e ho paura che muoia se non lo
          trovo presto! Puoi aiutarmi, per favore?"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 13
