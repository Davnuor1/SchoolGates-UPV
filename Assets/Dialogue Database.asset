        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Everybody deserves the same opportunities
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Todo el mundo merece las mismas oportunidades.
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Jeder verdient die gleichen Chancen
        type: 4
