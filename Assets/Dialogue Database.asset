      - title: de
        value: Sie sind nett zu mir...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "H\xE4n on yst\xE4v\xE4llinen minulle\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 46
      isRoot: 0
