        y: 659.2341
        width: 160
        height: 30
    - id: 15
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Wouldn\u2019t you like  to go whereever you like and buy everything
          you desire? Have all the foods, clothes, things you like? You can make
          this come true if you listen to me!"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xBFNo te gustar\xEDa ir a todas partes y comprar todo lo que deseas?
          \xBFTener toda la comida, la ropa, las cosas que te gustan? \xA1Puedes
          hacerlo realidad si me escuchas!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "W\xFCrdest Du nicht gerne \xFCberall hinlaufen und alles kaufen,
          was Du Dir w\xFCnschst? Alle Lebensmittel, Kleider, Dinge, die Dir gefallen?
          Du kannst dies wahr werden lassen, wenn Du mir zuh\xF6rst!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Etk\xF6 haluaisi menn\xE4 minne tahansa ja ostaa kaikkea, mit\xE4
          vain haluat? Saada kaiken ruoan, vaatteet, tavarat, joista pid\xE4t? Se
          kaikki voi toteutua, jos kuuntelet minua! "
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 47
        originDialogueID: 15
        destinationConversationID: 47
        destinationDialogueID: 16
