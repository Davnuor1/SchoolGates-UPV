        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "We can collect wood and make the bonfire bigger. Let\u2019s look
          around here and find branches, leaves and pieces of woods to throw in the
          fire to make it bigger"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Podemos recolectar madera y hacer la hoguera. Busquemos por aqu\xED
          y encontremos ramas, hojas y trozos de madera que podamos echar a la hoguera..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Wir k\xF6nnen Holz sammeln und das Lagerfeuer gr\xF6\xDFer machen.
          Lasst uns hier umschauen und \xC4ste, Bl\xE4tter und Holzst\xFCcke finden,
          die wir ins Feuer werfen k\xF6nnen, um es gr\xF6\xDFer zu machen."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Voimme ker\xE4t\xE4 puita ja tehd\xE4 isomman nuotion. Katsotaan,
          l\xF6ytyyk\xF6 t\xE4\xE4ll\xE4 oksia, lehti\xE4 ja puukappaleita, joita
          voidaan lis\xE4t\xE4 nuotioon ja tehd\xE4 siit\xE4 isompi"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 49
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
