      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "I forgot my lunch money and now can\u2019t buy anything to eat. I
          am so hungry..."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: es
        value: "Olvid\xE9 el dinero del almuerzo y ahora no puedo comprar nada para
          comer. Tengo tanta hambre..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Ich hab mein Essensgeld vergessen und nun kann ich mir nichts zu essen
          kaufen. Ich bin so hungrig....
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ho dimenticato i soldi per il pranzo e ora non posso comprare niente
          da mangiare. Ho cos\xEC tanta fame..."
        type: 4
        typeString: CustomFieldType_Localization
