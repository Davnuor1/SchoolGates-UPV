        height: 30
    - id: 30
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 6
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Now that you know what bullying does to people, you should apologise.
          How would you feel is it was you?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Ahora que sabes c\xF3mo afecta el bullying a las personas, deber\xEDas
          disculparte. \xBFC\xF3mo te sentir\xEDas si fueras t\xFA?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Jetzt, da Du wei\xDFt, welche Folgen Mobbing f\xFCr Menschen hat,
          solltest Du Dich entschuldigen. Wie w\xFCrdest Du Dich f\xFChlen, wenn
          Du es gewesen w\xE4rst?\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Nyt kun tied\xE4t, miten kiusaaminen vaikuttaa ihmisiin, sinun pit\xE4isi
          pyyt\xE4\xE4 anteeksi. Milt\xE4 sinusta tuntuisi, jos se olisit sin\xE4?"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 19
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 19
        originDialogueID: 30
        destinationConversationID: 19
        destinationDialogueID: 31
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 335.24716
        y: 1877.5935
        width: 160
        height: 30
    - id: 31
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I am very sorry, I didn\u2019t know, I didn\u2019t think. Please,
          accept my apologies, I will never do this to you again."
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Lo siento mucho, no lo sab\xEDa, no lo hab\xEDa pensado. Por favor,
          acepta mis disculpas, nunca volver\xE9 a hacerlo."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Es tut mir sehr leid, ich wusste es nicht, ich habe nicht nachgedacht.
          Bitte nimm meine Entschuldigung an, ich werde Dir das nie wieder antun
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Olen hyvin pahoillani, en tiennyt enk\xE4 ajatellut sit\xE4. Anna
          anteeksi, en en\xE4\xE4 koskaan tee sinulle mit\xE4\xE4n sellaista."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 19
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks: []
      conditionsString: 
      userScript: Variable["ConflictsSolved"] = Variable["ConflictsSolved"] + 1
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 500.0199
        y: 1941.2297
        width: 160
        height: 30
