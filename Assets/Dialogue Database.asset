      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xBFQu\xE9 crees que est\xE1 sucediendo realmente?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
