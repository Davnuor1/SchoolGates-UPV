    - id: 8
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "If you get together with people from other cultures and religions,
          be careful, you might get confused about your own identity\u2026 you might
          betray your own culture\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Si te juntas con gente de otras culturas y religiones, ten cuidado,
          puedes confundirte sobre tu propia identidad... Puedes traicionar tu propia
          cultura...
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Wenn Du mit Menschen anderer Kulturen und Religionen zusammenkommst,
          sei vorsichtig, denn sie k\xF6nnten hinsichtlich ihrer eigenen Identit\xE4t
          verwirrt werden \u2026 Sie k\xF6nnten ihre eigene Kultur verraten \u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Jos olet yhdess\xE4 muista kulttuureista ja uskonnoista kotoisin
          olevien ihmisten kanssa, ole varovainen, koska voit joutua ymm\xE4lle omasta
          identiteetist\xE4si\u2026 saatat pett\xE4\xE4 oman kulttuurisi\u2026 "
        type: 4
        typeString: CustomFieldType_Localization
