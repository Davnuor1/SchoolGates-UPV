        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "They want me to look the other way and hide the fact that there is
          an injustice here\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Quieren que mire hacia otro lado y oculte que aqu\xED hay una injusticia..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Sie wollen, dass ich wegschaue und verbergen, dass hier Ungerechtigkeit
          herrscht \u2026"
