      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Think of the consequences \u2026 Maybe there is something else happening
          here\u2026 Try again\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Piensa en las consecuencias... Tal vez aqu\xED est\xE9 pasando algo
          m\xE1s... Int\xE9ntalo de nuevo..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Denke an die Konsequenzen \u2026 Vielleicht passiert hier noch mehr
          \u2026 Versuche es noch einmal \u2026"
