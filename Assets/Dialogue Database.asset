    - id: 22
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I\u2019m not a thief, I do not even like your phone! Maybe you can
          helps us to find their phone, it must be around here\u2026\r\n"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "No soy un ladron, ni siquiera me gusta tu telefono! Igual podrias
          ayudarnos a buscar su telefono, seguro que est\xE1 por aqu\xED"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Ich bin kein Dieb, ich mag Dein Handy nicht mal! Vielleicht hilfst
          Du uns das Handy zu finden, es muss hier irgendwo sein...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Min\xE4 en ole mik\xE4\xE4n varas, en edes pid\xE4 puhelimestasi!
          Ehk\xE4 sin\xE4 voit auttaa meit\xE4 etsim\xE4\xE4n puhelimen, sen on pakko
          olla jossain t\xE4ss\xE4 l\xE4hell\xE4..."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 18
      isRoot: 0
      isGroup: 0
      nodeColor: 
