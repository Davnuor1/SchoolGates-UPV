    - id: 24
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Oh, c\u2019mon, you\u2019re being so dramatic! It\u2019s just a joke!
          Can\u2019t you take a joke?"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Oh, vamos, \xA1est\xE1s siendo tan dram\xE1tico! Es s\xF3lo una broma.
          \xBFNo sabes aceptar una broma?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Ach komm schon, du bist so dramatisch! Es ist nur ein Witz! Kannst
          Du keine Witze verstehen?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "\xC4l\xE4 nyt viitsi, olet niin dramaattinen! Se oli vain vitsi!
          Etk\xF6 kest\xE4 vitsailua? "
        type: 4
        typeString: CustomFieldType_Localization
