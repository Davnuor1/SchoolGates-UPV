      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xBFC\xF3mo te gustar\xEDa que nos dirijamos a ti?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Wie m\xF6chtest Du angesprochen werden?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Miten haluaisit, ett\xE4 sinua puhutellaan?"
        type: 4
