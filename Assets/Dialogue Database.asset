    - id: 22
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Congratulations! You have shown the courage to make the world a safe
          place and these are your new skills
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1Enhorabuena! Has demostrado el valor necesario para hacer del
          mundo un lugar seguro y \xE9stas son tus nuevas habilidades."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Herzlichen Gl\xFCckwunsch! Du hast den Mut gezeigt, die Welt zu einem
          sicheren Ort zu machen. Dies sind Deine neuen F\xE4higkeiten."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Onnittelut! Olet osoittanut rohkeutta tehd\xE4 maailman turvallisemmaksi
          paikaksi ja n\xE4m\xE4 ovat uusia taitojasi"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
