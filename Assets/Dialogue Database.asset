    - id: 14
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Abundance in one place may mean scarcity elsewhere. Consider the distribution
          of resources and be mindful of those who may have less
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "La abundancia en un lugar puede significar escasez en otro. Considera
          la distribuci\xF3n de los recursos y ten en cuenta a quienes puedan tener
          menos."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "\xDCberfluss an einem Ort kann Knappheit an einem anderen Ort bedeuten.
          Bedenke die Verteilung der Sachen und sei aufmerksam gegen\xFCber denen,
          die weniger haben."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ylt\xE4kyll\xE4isyys jossakin paikassa voi kieli\xE4 niukkuudesta
          jossakin muualla. Pid\xE4 mieless\xE4 resurssien jakautuminen ja ota huomioon
          ihmiset, joilla saattaa olla v\xE4hemm\xE4n."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 47
        originDialogueID: 14
        destinationConversationID: 47
        destinationDialogueID: 15
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
