    - id: 17
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "You awful creature, you are being mean\u2026 leave these people alone!"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Criatura horrible, est\xE1s siendo cruel... \xA1Deja a esta gente
          en paz!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Du schreckliches Gesch\xF6pf, Du bist gemein \u2026 lass diese Leute
          in Ruhe!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Olet kamala olento, olet ilke\xE4\u2026 j\xE4t\xE4 n\xE4m\xE4 ihmiset
          rauhaan!"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 46
      isRoot: 0
      isGroup: 0
      nodeColor: 
