      - title: Dialogue Text
        value: "Oh! Maybe that\u2019s not useful now\u2026 Maybe you\u2019re not
          feeling Joy"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
