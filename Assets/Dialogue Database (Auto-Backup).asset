      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Ugh... I've just lied to my parents, now I feel terrible...
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Uf... acabo de mentirle a mis padres, ahora me siento fatal...
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Igitt... Ich habe gerade meine Eltern belogen, jetzt f\xFChle ich
          mich schrecklich..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Uff... Ho appena mentito ai miei genitori, ora mi sento malissimo...
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Uf... acabo de mentirle a mis padres, ahora me siento fatal...
        type: 4
        typeString: CustomFieldType_Localization
