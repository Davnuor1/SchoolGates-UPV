      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xBFC\xF3mo respondes? \xBFCu\xE1l es la desigualdad en este caso?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Wie antwortest Du? Worin besteht hier die Ungleichheit?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: " Come rispondi? Qual \xE8 la disuguaglianza qui?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Miten vastaat? Mit\xE4 ep\xE4oikeudenmukaisuutta t\xE4\xE4ll\xE4
          on?"
        type: 4
        typeString: CustomFieldType_Localization
