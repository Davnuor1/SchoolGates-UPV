      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Hi, my names is Cass, nice to meet you! I\u2019m new at the school\u2026
          The coach introduced me to the class, told us to play and then left, but
          I don't know anyone...."
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Hola, me llamo Cass, \xA1encantada de conocerte! Soy nueva en el
          colegio... El entrenador me present\xF3 a la clase, nos dijo que jug\xE1ramos
          y luego se fue, pero no conozco a nadie\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Hey, mein Name ist Cass, sch\xF6n Dich kennen zulernen! Ich bin neu
          an der Schule....Der Trainer stellte mich der Klasse vor, sagte wir sollen
          spielen und dann war er weg. Ich kenne hier noch niemanden."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ciao, mi chiamo Cass, piacere di conoscerti! Sono nuova a scuola\u2026
          L'allenatore mi ha presentato alla classe, ci ha detto di giocare e poi
          se n'\xE8 andato, ma io non conosco nessuno...."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Min\xE4 olen Cass, kiva tavata! Olen uusi t\xE4ss\xE4 koulussa. Opettaja
          esitteli minut, k\xE4ski meit\xE4 pelaamaan ja l\xE4hti pois. En tunne
          ket\xE4\xE4n..."
        type: 4
        typeString: CustomFieldType_Localization
