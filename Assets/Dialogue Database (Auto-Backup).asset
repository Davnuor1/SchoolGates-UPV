    - id: 10
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: Oops, I don't have money for lunch either, but we can sit together
          for a while if you want.
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: es
        value: Ups, yo tampoco tengo dinero para comer, pero podemos sentarnos juntos
          un rato si quieres.
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Huch, ich hab auch kein Geld f\xFCr Mittag dabei, aber wir k\xF6nnen
          einfach so zusammen sitzen, wenn Du willst?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Oops, non ho soldi neanche per il pranzo, ma possiamo sederci insieme
          per un po' se vuoi.
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Hups, minullakaan ei ole rahaa lounaaseen, mutta voidaan istua yhdess\xE4
          hetki, jos haluat."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 16
