      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "They want me to look the other way and hide the fact that there is
          an injustice here\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Quieren que mire hacia otro lado y oculte que aqu\xED hay una injusticia..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Sie wollen, dass ich wegschaue und verheimlichen die Ungerechtigkeit
          hier\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Vogliono che guardi dall\u2019altra parte e nasconda il fatto che
          qui c\u2019\xE8 un\u2019ingiustizia\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "He haluavat minun katsovan toisaalle ja salaavan sen tosiasian, ett\xE4
          t\xE4\xE4ll\xE4 on ep\xE4oikeudenmukaisuutta\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 46
