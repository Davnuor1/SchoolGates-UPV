    - id: 6
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 4
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Ok\u2026 envy is a powerful emotion\u2026 Do you like that? Do you
          want it for you? Don\u2019t waste energy with envy, use it to accomplish
          your own goals."
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Vale... la envidia es una emoci\xF3n poderosa... \xBFTe gusta? \xBFLa
          quieres para ti? No malgastes energ\xEDa con la envidia, util\xEDzala para
          lograr tus propios objetivos."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ok\u2026 Neid ist ein starkes Gef\xFChl\u2026 Gef\xE4llt Dir das?
          Willst Du es f\xFCr Dich? Verschwende keine Energie mit Neid, sondern nutze
          es, um Deine eigenen Ziele zu erreichen."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ok\u2026 l\u2019invidia \xE8 un\u2019emozione potente\u2026 Ti piace?
          La vuoi per te? Non sprecare energia con l\u2019invidia, usala per raggiungere
          i tuoi obiettivi"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Okei\u2026 kateus on voimakas tunne\u2026 Pid\xE4tk\xF6 siin\xE4?
          Haluatko tuntea niin? \xC4l\xE4 hukkaa energiaa kadehtimiseen, k\xE4yt\xE4
          se energia omien tavoitteittesi saavuttamiseen"
        type: 4
        typeString: CustomFieldType_Localization
