    - id: 21
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: He has stolen my phone...
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Me ha robado el movil...
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Er hat mein Telefon gestohlen...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Mi ha rubato il telefono...
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "H\xE4n varasti puhelimeni\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 18
      isRoot: 0
