      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Think of the consequences \u2026 Maybe there is something elsehappening
          here\u2026 Try again\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Piensa en las consecuencias\u2026 Tal vez aqu\xED est\xE9 pasando
          algo m\xE1s... Int\xE9ntalo de nuevo..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Denke an die Konsequenzen \u2026 Vielleicht passiert hier noch mehr
          \u2026 Versuch es noch einmal \u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Pensa alle conseguenze... Forse sta succedendo qualcosa di pi\xF9
          qui... Riprova..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Mieti seurauksia \u2026 Ehk\xE4 t\xE4\xE4ll\xE4 tapahtuu jotakin
          muutakin\u2026 Yrit\xE4 uudelleen\u2026"
        type: 4
        typeString: CustomFieldType_Localization
