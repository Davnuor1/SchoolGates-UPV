      - title: de
        value: "Lass uns dort dr\xFCben am Tisch sitzen und wir k\xF6nnen mein Mittag
          teilen. Ich hab genug f\xFCr uns Beide"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Sediamoci l\xEC a tavola e possiamo condividere il mio pranzo, ce
          n'\xE8 abbastanza per tutti e due!"
        type: 4
        typeString: CustomFieldType_Localization
