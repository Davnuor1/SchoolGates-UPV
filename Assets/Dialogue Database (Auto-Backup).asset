        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: What do you want to say? What is the inequality here?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xBFQu\xE9 quieres decir? \xBFCu\xE1l es la desigualdad aqu\xED?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Was willst Du sagen? Was ist hier die Ungleichheit?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Cosa vuoi dire? Qual \xE8 la disuguaglianza qui?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Mit\xE4 haluat kertoa? Mit\xE4 ep\xE4oikeudenmukaisuutta t\xE4\xE4ll\xE4
          on?"
        type: 4
        typeString: CustomFieldType_Localization
