      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Gracias por ayudarme! Te alcanzar\xE9 despu\xE9s de recuperar mi
          aliento!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Danke f\xFCr die Hilfe, ich melde mich wieder, wenn ich wieder zu
          Atem gekommen bin!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Grazie per avermi aiutato, ti raggiungo appena riprendo fiato!
        type: 4
