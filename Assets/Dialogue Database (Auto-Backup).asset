        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Ok, you are right! I can go to the Vet tomorrow\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1Vale, tienes raz\xF3n! Puedo ir al veterinario ma\xF1ana.."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Okay, Du hast Recht! Ich kann morgen zum Tierarzt gehen...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ok, hai ragione! Posso andare dal veterinario domani\u2026"
