    - id: 17
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "You awful creature, you are being selfish! You don\u2019t deserve
          all this just for yourself\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Criatura horrible, \xA1est\xE1s siendo ego\xEDsta! No te mereces
          todo esto s\xF3lo para ti..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Du schreckliche Kreatur, Du bist egoistisch! Du verdienst all das
          nicht nur f\xFCr Dich allein\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Orribile creatura, sei egoista! Non meriti tutto questo solo per te...
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Senkin kamala olento, olet itsek\xE4s! Et ansaitse t\xE4t\xE4 kaikkea
          vain itsellesi\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
