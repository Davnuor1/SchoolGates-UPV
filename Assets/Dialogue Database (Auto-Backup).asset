        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Don\u2019t overreact. Just let it sleep and it will get better soon...
          We are waiting for you to play!"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "No exageres. D\xE9jala dormir y pronto mejorar\xE1... \xA1Te estamos
          esperando para jugar!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "\xDCbertreib nicht. Lass es einfach schlafen und es wird bald besser...
          Wir warten auf Dich zum Spielen!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Non esagerare. Lascialo dormire e presto guarir\xE0... Ti aspettiamo
          per giocare!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "\xC4l\xE4 h\xE4t\xE4ile. Anna sen nukkua, kyll\xE4 se siit\xE4. Tule
          pelaamaan!"
        type: 4
        typeString: CustomFieldType_Localization
