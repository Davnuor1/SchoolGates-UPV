      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "But don\u2019t you see how different they are from you?"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Pero, \xBFno ves lo diferentes que son de ti?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Aber siehst Du nicht, wie sehr sie sich von Dir unterscheiden?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Ma non vedi quanto sono diversi da te?
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Mutta etk\xF6 n\xE4e, miten erilaisia kuin sin\xE4 he ovat?"
        type: 4
        typeString: CustomFieldType_Localization
