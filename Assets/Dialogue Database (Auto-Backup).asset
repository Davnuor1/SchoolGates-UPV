      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: es
        value: "Eres muy amable, gracias. \xA1Otro d\xEDa te invito yo!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Du bist sehr nett, danke. Ich werde Dich an einem anderen Tag einladen!
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: " \u201CSei molto gentile, grazie. Ti inviter\xF2 la  prossima volta!"
