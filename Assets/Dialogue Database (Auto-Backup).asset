    - id: 19
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Try to be more compassionate. Everybody deserves to be treated with
          kindness and compassion... Try again.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Intenta mostrarte m\xE1s compasivo/a. Todo el mundo merece ser tratado
          con amabilidad y compasi\xF3n."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Versuche, mitf\xFChlender zu sein. Jeder verdient es, mit Freundlichkeit
          und Mitgef\xFChl behandelt zu werden."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Cerca di essere pi\xF9 compassionevole. Tutti meritano di essere
          trattati con gentilezza e compassione"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Yrit\xE4 olla my\xF6t\xE4tuntoisempi. Jokainen ansaitsee tulla kohdelluksi
          huomaavaisesti ja my\xF6t\xE4tuntoisesti."
        type: 4
        typeString: CustomFieldType_Localization
