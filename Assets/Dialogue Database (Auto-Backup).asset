    - id: 23
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "He\u2019s  always calling me names, making fun of me\u2026  I don\u2019t
          like it\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Siempre me est\xE1 insultando y burl\xE1ndose de m\xED... No me gusta..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Er beleidigt mich und macht sich einen Spa\xDF daraus...ich mag das
          nicht...\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Mi insulta sempre , mi prende in giro... non mi piace...
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "H\xE4n nimittelee minua aina, ja pilkkaa minua... En pid\xE4 siit\xE4...\r\n"
        type: 4
        typeString: CustomFieldType_Localization
