      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Tu amigo esta agradecido con su padre por introducirlo en el deporte
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Dein Freund ist dankbar, dass sein Vater ihn in den Sport eingef\xFChrt
          hat "
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Il tuo amico \xE8 grato che suo padre gli abbia fatto conoscere questo
