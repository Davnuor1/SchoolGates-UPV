    - id: 9
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Let\u2019s sit down over there at the table and we can share my lunch,
          there is enough for the two of us!"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: es
        value: "Sent\xE9monos en aquella mesa y compartimos mi almuerzo, \xA1hay
          suficiente para los dos!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Lass uns dort dr\xFCben am Tisch sitzen und wir k\xF6nnen mein Mittag
          teilen. Ich hab genug f\xFCr uns beide."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Sediamoci l\xEC a tavola e possiamo condividere il mio pranzo, ce
          n'\xE8 abbastanza per tutti e due!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Istutaan t\xE4h\xE4n p\xF6yt\xE4\xE4n, voin jakaa lounaani kanssasi.
          Siit\xE4 riitt\xE4\xE4 meille molemmille!"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 16
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
