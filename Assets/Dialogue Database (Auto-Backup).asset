        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I understand you because I feel stupid sometimes, too\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Te entiendo porque yo tambi\xE9n me siento idiota a veces\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ich verstehe Dich, weil ich mich auch manchmal dumm f\xFChle..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ti capisco perch\xE9 anch'io a volte mi sento stupido.."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ymm\xE4rr\xE4n sinua. Minustakin tuntuu joskus silt\xE4."
