    - id: 8
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "You deserve everything you desire\u2026 Do you want anything else?
          I have everything you could imagine\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Te mereces tener todo lo que quieras... \xBFQuieres algo m\xE1s?
          Tengo todo lo que puedas imaginar..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Du verdienst es, alles zu bekommen, was Du m\xF6chtest\u2026 M\xF6chtest
          Du noch etwas? Ich habe alles, was Du Dir vorstellen kannst\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Meriti di ottenere tutto ci\xF2 che desideri\u2026 Vuoi qualcos'altro?
          Ho tutto quello che puoi immaginare..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ansaitset kaiken, mit\xE4 haluat\u2026 Haluatko jotakin muuta? Minulla
          on kaikkea, mit\xE4 voit kuvitella\u2026"
        type: 4
        typeString: CustomFieldType_Localization
