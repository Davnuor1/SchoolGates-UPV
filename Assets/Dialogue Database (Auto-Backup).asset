    - id: 10
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Excluding individuals from a social group due to their appearance
          or lifestyle is discrimination
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Excluir a personas de un grupo social por su aspecto o estilo de
          vida es discriminaci\xF3n."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Personen aufgrund ihres Aussehens oder ihres Lebensstils aus einer
          sozialen Gruppe auszuschlie\xDFen, ist Diskriminierung."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Escludere individui da un gruppo sociale a causa del loro aspetto
          o stile di vita \xE8 una discriminazione"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ihmisten j\xE4tt\xE4minen sosiaalisen ryhm\xE4n ulkopuolelle heid\xE4n
          ulkon\xE4k\xF6ns\xE4 tai el\xE4m\xE4ntapansa takia on syrjint\xE4\xE4."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 45
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
