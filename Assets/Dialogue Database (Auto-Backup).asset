        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "They want to share their resources with me\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Quieren compartir sus recursos conmigo...
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Sie wollen ihre Sachen mit mir teilen\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Vogliono condividere le loro risorse con me\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "H\xE4n haluaa jakaa ruokansa kanssani\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
