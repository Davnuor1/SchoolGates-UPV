        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Oh, ok! That\u2019s nothing to be upset about... I'm going on my
          way"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1Ah, vale! No hay por qu\xE9 disgustarse... Yo me marcho."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Oh, ok! Das ist doch nichts, wor\xFCber man traurig sein muss...
          Ich gehe einfach weiter."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Oh, ok! Non c'\xE8 niente di cui preoccuparsi... vado per la mia
          strada"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Okei... No, ei se ole niin iso juttu. Min\xE4 jatkan matkaa."
        type: 4
        typeString: CustomFieldType_Localization
