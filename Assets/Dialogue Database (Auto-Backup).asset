        typeString: CustomFieldType_Localization
      - title: it
        value: "Loro non appartengono a questo posto... Tu sei pi\xF9 importante
          di loro..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "He eiv\xE4t kuulu t\xE4nne\u2026 Sin\xE4 olet heit\xE4 t\xE4rke\xE4mpi\u2026"
