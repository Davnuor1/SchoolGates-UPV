      - title: it
        value: no
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: Ei
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 19
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
