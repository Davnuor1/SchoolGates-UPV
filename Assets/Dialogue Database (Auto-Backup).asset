      - title: Dialogue Text
        value: Great, you are being clear and brief
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Genial, est\xE1s hablando claro y conciso."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Gro\xDFartig, Du bist klar und kurz."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Ottimo, sei stato chiaro e breve
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Hienoa, ilmaiset itse\xE4si selke\xE4sti ja lyhyesti."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
