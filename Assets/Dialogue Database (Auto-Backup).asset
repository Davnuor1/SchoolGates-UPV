      - title: Dialogue Text
        value: Lots of people pass the cafeteria and the kid doesn't look really
          in trouble
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Pasa mucha gente por la cafeter\xEDa y el chico no parece estar metido
          \_\_\_\_en problemas"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Viele Leute gehen an der Cafeteria vorbei und das Kind sieht nicht
          so aus, als h\xE4tte es Schwierigkeiten."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Molte persone passano davanti alla mensa e il ragazzo non sembra
          davvero in difficolt\xE0 "
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ruokalan ohi kulkee paljon ihmisi\xE4. Lapsi ei n\xE4yt\xE4 olevan
          pulassa."
        type: 4
        typeString: CustomFieldType_Localization
