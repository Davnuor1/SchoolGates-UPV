      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Nothing is happening here\u2026 It\u2019s just a joke\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Aqu\xED no pasa nada... Es s\xF3lo una broma..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Nichts passiert hier....Es ist nur ein Witz...
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Qui non sta succedendo nulla... \xE8 solo uno scherzo..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Ei mit\xE4\xE4n... Se oli vain vitsi..."
        type: 4
        typeString: CustomFieldType_Localization
