        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Great, you are showing compassion, it doesn't take much to be kind!
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
