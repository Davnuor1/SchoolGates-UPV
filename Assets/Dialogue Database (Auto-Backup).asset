    - id: 8
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: What would you like to eat for lunch? Choose anything you want, my
          treat
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: es
        value: "\xBFQu\xE9 te apetece comer? Elige lo que quieras, yo invito."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Was w\xFCrdest Du gerne zum Mittag essen? W\xE4hle, was Du willst,
          heute geht es auf mich!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Cosa vorresti mangiare per pranzo? Scegli quello che vuoi, offro io
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Mit\xE4 haluaisit lounaaksi? Valitse, mit\xE4 vain haluat, min\xE4
          tarjoan"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 16
      isRoot: 0
      isGroup: 0
      nodeColor: 
