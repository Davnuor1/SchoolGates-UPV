        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "I don\u2019t think that is a good idea, I\u2019ll put the pet in
          the carrier and go to the Vet right now"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "No creo que sea una buena idea, pondr\xE9 a la mascota en el transport\xEDn
          e ir\xE9 al veterinario ahora mismo"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Ich glaube nicht, dass das eine gute Idee ist. Ich gehe sofort zum
          Tierarzt
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: 
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
