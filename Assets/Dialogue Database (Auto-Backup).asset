        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Yes, he probably wants you not to think about this\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "S\xED, probablemente no quiere que pienses en ello..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ja, er m\xF6chte wahrscheinlich, dass Du nicht daran denkst \u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "S\xEC, probabilmente vuole che tu non ci pensi\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Kyll\xE4, h\xE4n luultavasti haluaa sinun olevan ajattelematta t\xE4t\xE4..."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 46
