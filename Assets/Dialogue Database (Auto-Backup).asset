      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: Recuerda lo que has aprendido sobre transmitir un mensaje breve...
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Denke daran, was Du \xFCber das Geben einer kurzen Nachricht gelernt
          hast\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ricorda cosa hai imparato riguardo al dare un breve messaggio\u2026\u201D"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Muista, mit\xE4 olet oppinut lyhyest\xE4 viestimisest\xE4..."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
