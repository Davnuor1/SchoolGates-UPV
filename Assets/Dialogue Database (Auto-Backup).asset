    - id: 5
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Great! Joy asks to be shared in order to be balanced. The vitality
          of joy allows you to do many things and do them with care, optimism and
          confidence.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Bien! La alegr\xEDa pide ser compartida para estar equilibrada. La
          vitalidad de la alegr\xEDa te permite hacer muchas cosas y hacerlas con
          cari\xF1o, optimismo y confianza"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Super! Freude m\xF6chte geteilt werden, um ausgeglichen zu sein.
          Die Vitalit\xE4t der Freude erm\xF6glicht es Dir, viele Dinge zu tun und
          sie mit Sorgfalt, Optimismus und Zuversicht zu erledigen."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Fantastico! La gioia chiede di essere condivisa per essere equilibrata.
          La vitalit\xE0 della gioia ti consente di fare tante cose e di farle con
          cura, ottimismo e sicurezza. Ti sentirai pi\xF9 equilibrato dopo\u2026
          Continua cos\xEC!\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Hienoa! Ilo pyyt\xE4\xE4 tulla jaetuksi ollakseen tasapainossa. Iloon
          liittyv\xE4 elinvoimaisuus mahdollistaa useiden asioiden tekemisen ja niiden
          tekemisen huolellisuudella, optimismilla ja luottamuksella. Olosi on sen
          j\xE4lkeen tasapainoisempi\u2026 Jatka!"
        type: 4
        typeString: CustomFieldType_Localization
