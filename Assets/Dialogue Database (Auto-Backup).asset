      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "You awful creature, you are being mean\u2026 let theseis people enter
          the house or or we will tear it down!"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Criatura horrible, est\xE1s siendo cruel... \xA1deja que esta gente
          entre en la casa o la derribaremos!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Du schreckliches Gesch\xF6pf, Du bist gemein \u2026 lass diese Leute
          das Haus betreten, sonst rei\xDFen wir es ab!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Orribile creatura, sei cattivo... lascia che questa gente entri in
          casa o la demoliremo!
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Olet kamala olento, olet ilke\xE4\u2026 p\xE4\xE4st\xE4 n\xE4m\xE4
          ihmiset sis\xE4lle tai hajotamme talon maan tasalle!"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 45
      isRoot: 0
      isGroup: 0
