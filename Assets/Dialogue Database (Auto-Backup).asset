      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Poor child! I remember how I loved my teddy bear when I was little.
          I must help this child!
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1Pobre ni\xF1o/a! Recuerdo c\xF3mo quer\xEDa a mi osito de peluche
          cuando ten\xEDa su edad. \xA1Tengo que echarle una mano!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Armes Kind! Ich erinnere mich, wie sehr ich meinen Teddyb\xE4r geliebt
          habe, als ich klein war. Ich muss diesem Kind helfen!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Povero bambino! Ricordo quanto amavo il mio orsacchiotto quando ero
          piccolo. Devo aiutare questo bambino!
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Voi kuinka ik\xE4v\xE4\xE4! Muistan, kuinka kovasti tykk\xE4sin omasta
          nallestani pienen\xE4. Minun t\xE4ytyy auttaa!"
        type: 4
        typeString: CustomFieldType_Localization
