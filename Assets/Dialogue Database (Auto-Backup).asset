    - id: 23
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Isn't it right there on the ground?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xBFNo es eso que esta en el suelo?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: Liegt es nicht genau dort auf dem Boden?
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Non \xE8 proprio l\xEC per terra?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Eik\xF6 se ole maassa?"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 18
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 18
        originDialogueID: 23
        destinationConversationID: 18
        destinationDialogueID: 24
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
