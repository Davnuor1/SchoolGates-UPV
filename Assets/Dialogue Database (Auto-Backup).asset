      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Look at you! You look so ridiculous with your clothes! What are you?
          A boy or a girl?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1M\xEDrate! \xA1Que rid\xEDculo est\xE1s con esa ropa! \xBFQu\xE9
          eres? \xBFUn chico o una chica?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Schau Dich an! Du siehst in Deinen Klamotten so l\xE4cherlich aus!
          Was bist Du? Ein Junge oder ein M\xE4dchen?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Guardati! Sei cos\xEC ridicolo con i tuoi vestiti! Che cosa siete?
          Un ragazzo o una ragazza?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Katso nyt itse\xE4si! Vaatteesi n\xE4ytt\xE4v\xE4t niin naurettavilta!
          Mik\xE4 sin\xE4 olet? Poika vai tytt\xF6?"
        type: 4
        typeString: CustomFieldType_Localization
