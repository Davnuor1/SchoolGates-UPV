        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "\xA1He perdido mi osito de peluche!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ich habe meinen Teddyb\xE4r verloren!"
