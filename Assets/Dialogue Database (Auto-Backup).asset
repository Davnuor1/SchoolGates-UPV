        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Hey... I just came from my uncle's funeral, it's been a very sad day
          for me...
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Ey... acabo de llegar del funeral de mi tio, ha sido un d\xEDa muy
          triste para mi..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Hey... Ich komme gerade von der Beerdigung meines Onkels, es war
          ein sehr trauriger Tag f\xFCr mich..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Ehi... Sono appena tornato dal funerale di mio zio, \xE8 stata una
          giornata molto triste per me..."
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Hei... tulin juuri set\xE4ni hautajaisista, t\xE4m\xE4 on ollut minulle
          hyvin surullinen p\xE4iv\xE4..."
        type: 4
        typeString: CustomFieldType_Localization
