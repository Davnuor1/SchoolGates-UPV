      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: I think my pet is sick, I was thinking about going to the vet.
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Creo que mi mascota est\xE1 enferma, estaba pensando en ir al veterinario"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ich glaube mein Haustier ist krank, ich habe dar\xFCber nachgedacht
          zum Tierarzt zu gehen"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Non reagire in modo esagerato. Lascia che si riposi e presto star\xE0
          meglio... Ti aspettiamo per giocare!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Luulen, ett\xE4 lemmikkini on sairas. Ajattelin vied\xE4 sen el\xE4inl\xE4\xE4k\xE4riin."
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 68
