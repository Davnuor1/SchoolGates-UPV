      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Tonight we're having a party because I've just been accepted into
          my dream school! It's the best day of my life!
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Esta noche vamos a celebrar una fiesta porque me acaban de aceptar
          en la escuela de mis sue\xF1os! Es el mejor d\xEDa de mi vida!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Heute Abend feiern wir eine Party, weil ich gerade an meiner Traumschule
          angenommen worden bin! Das ist der sch\xF6nste Tag in meinem Leben!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "Stasera festeggiamo perch\xE9 sono appena stato ammesso alla scuola
          dei miei sogni! \xC8 il giorno pi\xF9 bello della mia vita!"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "T\xE4n\xE4 iltana pid\xE4mme juhlat, koska minut on juuri hyv\xE4ksytty
          unelmieni kouluun! T\xE4m\xE4 on el\xE4m\xE4ni paras p\xE4iv\xE4!"
        type: 4
        typeString: CustomFieldType_Localization
