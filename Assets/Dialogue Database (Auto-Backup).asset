    - id: 16
      fields:
      - title: Title
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Description
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Actor
        value: 2
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
        value: 1
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: Before you answer, immerse yourself into the world of the Manigore!
          What answer would you want to hear yourself?
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "Antes de responder, sum\xE9rgete en el mundo de Manigore. \xBFQu\xE9
          respuesta te gustar\xEDa escuchar a ti mismo?\r\n"
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Bevor Du antwortest, versetze Dich in die Welt des Manigores! Welche
          Antwort w\xFCrdest Du selbst h\xF6ren wollen?"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: Prima di rispondere, immergiti nel mondo di Manigore! Quale risposta
          vorresti sentire tu stesso?
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Miten haluaisit, ett\xE4 sinua puhutellaan?"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 47
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: Block
      conditionPriority: 2
      outgoingLinks:
