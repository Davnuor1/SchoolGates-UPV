      - title: Menu Text
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "Yes, he probably wants you not to think about this\u2026"
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: es
        value: "S\xED, probablemente quiere que no pienses en esto.."
        type: 4
        typeString: CustomFieldType_Localization
      - title: de
        value: "Ja, wahrscheinlich m\xF6chten sie, dass Du nicht dar\xFCber nachdenkst\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: it
        value: "\xEC, probabilmente vuole che tu non pensi a questo\u2026"
        type: 4
        typeString: CustomFieldType_Localization
      - title: fi
        value: "Kyll\xE4, h\xE4n luultavasti haluaa sinun olevan ajattelematta t\xE4t\xE4\u2026"
        type: 4
        typeString: CustomFieldType_Localization
