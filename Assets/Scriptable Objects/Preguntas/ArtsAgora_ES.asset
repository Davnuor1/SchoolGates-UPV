  m_Name: ArtsAgora_ES
  m_EditorClassIdentifier: 
  collectionName: Arts
  questions:
  - questionText: "\xBFQu\xE9 autor escribi\xF3 el famoso verso \"Volver\xE1n las
      oscuras golondrinas/ En tu balc\xF3n sus nidos a colgar\"?"
    answers:
    - " Federico Garc\xEDa Lorca"
    - "Gustavo Adolfo B\xE9cquer"
    - Antonio Machado
    - "Juan Ram\xF3n Jim\xE9nez"
    correctAnswerIndex: 1
  - questionText: "\xBFQui\xE9n escribi\xF3 la obra Platero y yo?"
    answers:
    - "Ram\xF3n Mar\xEDa del Valle-Incl\xE1n"
    - "Juan Ram\xF3n Jim\xE9nez"
    - "Vicente Blasco Ib\xE1\xF1ez"
    - "P\xEDo Baroja"
    correctAnswerIndex: 1
  - questionText: "\xBFDe d\xF3nde era Wolfgang Amadeus Mozart?"
    answers:
    - Alemania
    - Austria
    - Suecia
    - "Pa\xEDses Bajos"
    correctAnswerIndex: 1
  - questionText: "\xBFQu\xE9 artista version\xF3 el poema \"\xBFCaminante, no hay
      camino\u201D de Antonio Machado en una famosa canci\xF3n?"
    answers:
    - Joan Manuel Serrat
    - "Joaqu\xEDn Sabina"
    - "Pablo Albor\xE1n"
    - "Miguel Bos\xE9"
    correctAnswerIndex: 0
  - questionText: "\xBFQui\xE9n es la pintora mexicana conocida por sus autorretratos
      surrealistas y representaciones de la cultura ind\xEDgena mexicana?"
    answers:
    - Frida Kahlo
    - Georgia O'Keeffe
    - Yayoi Kusama
    - Tamara de Lempicka
    correctAnswerIndex: 0
  - questionText: "\xBFQui\xE9n esculpi\xF3 La Piedad?"
    answers:
    - Da Vinci
    - "Miguel \xC1ngel"
    - Rafael
    - Tiziano
    correctAnswerIndex: 1
  - questionText: "\xBFQu\xE9 personaje en El Principito de Antoine de Saint-Exup\xE9ry
      representa el amor y la fragilidad, y es el objeto de la devoci\xF3n del principito,
      aunque tambi\xE9n le causa confusi\xF3n y dolor?"
    answers:
    - El zorro
    - La serpiente
    - La rosa
    - El aviador
    correctAnswerIndex: 2
  - questionText: "\xBFCu\xE1l de los siguientes g\xE9neros musicales se origin\xF3
      en la comunidad afroamericana en el sur de los Estados Unidos y es conocido
      por su ritmo y la improvisaci\xF3n?"
    answers:
    - Rock
    - Jazz
    - "Reguet\xF3n"
    - "Cl\xE1sica"
    correctAnswerIndex: 1
  - questionText: "\xBFCu\xE1l de las siguientes obras es una tragedia escrita por
      William Shakespeare?"
    answers:
    - Don Juan Tenorio
    - "Cien a\xF1os de soledad"
    - Romeo y Julieta
    - La casa de Bernarda Alba
    correctAnswerIndex: 2
  - questionText: "\xBFCu\xE1l es el g\xE9nero literario de \"El Se\xF1or de los
      Anillos\"?"
    answers:
    - Fantasia
    - Realismo
    - Surrealismo
    - "Poes\xEDa"
    correctAnswerIndex: 0
