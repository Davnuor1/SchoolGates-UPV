%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e418474bb2a30542b702a5d9eab1987, type: 3}
  m_Name: Espejos02_FI
  m_EditorClassIdentifier: 
  textoPreguntaInicial: "N\xE4etk\xF6 itsesi t\xE4ss\xE4 peiliss\xE4?"
  textoPreguntaRating: "Kuinka paljon t\xE4m\xE4 muistuttaa sinua asteikolla 1\u201310?"
  textoFeedbackLike: "Hienoa! Jatketaan todellisen min\xE4si etsimist\xE4\u2026"
  textoFeedbackDislikeFinal: "Ok\u2026 pid\xE4 t\xE4m\xE4 mieless\xE4 ja jatka etsimist\xE4."
  textoDoYouAgree: "Oletko samaa mielt\xE4?"
  espejos:
  - nombre: "Minun pit\xE4\xE4 tehd\xE4 kaikki oikein ja saada muut iloisiksi, muuten
      olen huono."
    feedback01: "Kaikki eiv\xE4t tule aina tykk\xE4\xE4m\xE4\xE4n sinusta \u2013
      ja se on ihan ok."
    feedback02: "Arvosi ei riipu siit\xE4, mit\xE4 muut sinusta ajattelevat."
  - nombre: "Muiden pit\xE4\xE4 aina kohdella minua reilusti ja yst\xE4v\xE4llisesti
      \u2013 muuten he ovat pahoja."
    feedback01: "Toiset eiv\xE4t aina osaa k\xE4ytt\xE4yty\xE4 hyvin. Joskus he ovat
      surullisia tai vihaisia."
    feedback02: "Huono k\xE4yt\xF6s ei v\xE4ltt\xE4m\xE4tt\xE4 tarkoita, ett\xE4
      joku on paha ihminen."
  - nombre: "Jos el\xE4m\xE4 ei ole helppoa ja mukavaa, en voi nauttia siit\xE4. "
    feedback01: "El\xE4m\xE4 vaihtelee: joskus on vaikeaa, joskus ihanaa. "
    feedback02: "Jokainen yl\xE4- ja alam\xE4ki opettaa sinulle jotakin t\xE4rke\xE4\xE4. "
  - nombre: "Kaikkien, joista v\xE4lit\xE4n, t\xE4ytyy rakastaa minua! Muuten en
      kest\xE4. "
    feedback01: "Rakastavat ihmiset eiv\xE4t aina ole samaa mielt\xE4 kanssasi \u2013
      mutta he rakastavat sinua silti. "
    feedback02: "Toisiaan rakastavat ihmiset osaavat kuunnella ja ratkaista riitoja
      yhdess\xE4."
  - nombre: "Minun t\xE4ytyy saavuttaa jotain suurta, muuten olen arvoton. "
    feedback01: "Olet arvokas sellaisena kuin olet \u2013 ei siin\xE4, mit\xE4 omistat
      tai teet. "
    feedback02: 'Vaikeudet auttavat sinua kasvamaan ja oppimaan. '
  - nombre: "Kukaan ei saisi k\xE4ytt\xE4yty\xE4 huonosti, ja jos joku tekee niin,
      minun pit\xE4\xE4 sanoa siit\xE4. "
    feedback01: "Kukaan ei ole t\xE4ydellinen. Joskus ihmiset k\xE4ytt\xE4ytyv\xE4t
      huonosti, koska heill\xE4 on vaikeaa. "
    feedback02: "Ennen kuin suutut, voit yritt\xE4\xE4 ymm\xE4rt\xE4\xE4, miksi toinen
      toimi niin. "
  - nombre: "Jos en saa mit\xE4 haluan, se tarkoittaa, etten ole tarpeeksi hyv\xE4. "
    feedback01: 'On ihan ok olla turhautunut. Kaikki ei aina mene suunnitelmien mukaan. '
    feedback02: "Turhautuminen on normaali tunne \u2013 ja se voi auttaa sinua oppimaan
      uutta."
  - nombre: "Kun kaikki tuntuu vaikealta ja olen ihan uupunut, tuntuu kamalalta eik\xE4
      mik\xE4\xE4n auta. "
    feedback01: "On normaalia olla alakuloinen vaikeina aikoina \u2013 mutta voit
      aina valita, miten suhtaudut siihen."
    feedback02: "Sen sijaan ett\xE4 luovutat, voit kokeilla keinoja, jotka auttavat
      sinua jaksamaan paremmin. "
  - nombre: "Jos tapahtuu jotain pahaa, en saa sit\xE4 pois mielest\xE4ni. Minun
      pit\xE4\xE4 v\xE4ltt\xE4\xE4 sit\xE4 hinnalla mill\xE4 hyv\xE4ns\xE4."
    feedback01: "On normaalia pel\xE4t\xE4, mutta liika miettiminen tai v\xE4lttely
      voi tehd\xE4 olon pahemmaksi."
    feedback02: "Kaikki pelottava ei ole oikeasti vaarallista. Kannattaa mietti\xE4:
      onko t\xE4m\xE4 oikeasti iso juttu vai tuntuuko se vain silt\xE4?"
  - nombre: "Voin j\xE4tt\xE4\xE4 velvollisuudet ja ongelmat huomiotta ja silti olla
      onnellinen."
    feedback01: "On normaalia haluta v\xE4ltell\xE4 vaikeita asioita \u2013 mutta
      niiden kohtaaminen auttaa sinua eteenp\xE4in."
    feedback02: "Vaikeiden asioiden pakoilu voi tuntua helpolta hetken, mutta pitk\xE4ll\xE4
      aikav\xE4lill\xE4 se tuo enemm\xE4n stressi\xE4."
  - nombre: "Menneisyyteni on t\xE4rkein asia el\xE4m\xE4ss\xE4ni, ja se vaikuttaa
      aina siihen, mit\xE4 tunnen, ajattelen ja teen."
    feedback01: "Menneisyys on osa sinua, mutta se ei m\xE4\xE4rittele sinua. Se,
      mit\xE4 teet nyt, on t\xE4rke\xE4mp\xE4\xE4."
    feedback02: "Menneisyys ei m\xE4\xE4rittele sinua. Voit tehd\xE4 edelleen valintoja,
      jotka muuttavat tulevaisuuttasi."
  - nombre: "Virheet ovat heikoille. Vain t\xE4ydellinen kelpaa. "
    feedback01: "Jos odottaa t\xE4ydellisyytt\xE4, pettyy helposti. Kukaan ei ole
      t\xE4ydellinen. "
    feedback02: "On hyv\xE4 haluta kehitty\xE4, mutta pit\xE4\xE4 my\xF6s hyv\xE4ksy\xE4
      asiat sellaisina kuin ne nyt ovat. "
  - nombre: "Voin olla onnellinen tekem\xE4ll\xE4 mahdollisimman v\xE4h\xE4n ja vain
      nauttimalla. "
    feedback01: "Onnellisuus ei ole vain hauskanpitoa \u2013 siihen kuuluu my\xF6s
      vaikeiden asioiden kohtaaminen ja oppiminen. "
    feedback02: "Onnellisuus syntyy my\xF6s tavoitteista, toisten auttamisesta ja
      omasta kasvusta. Se vaatii v\xE4h\xE4n vaivaa. "
