%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 457a34b01ea1a0147ac69562ed6959ec, type: 3}
  m_Name: Espejos01_FI
  m_EditorClassIdentifier: 
  textoPreguntaInicial: "Valitse peilit, jotka n\xE4ytt\xE4v\xE4t todellisen min\xE4si."
  textoPreguntaRating: "Kuinka paljon t\xE4m\xE4 muistuttaa sinua asteikolla 1\u201310?"
  textoPreguntaParte2: "Katsotaanpa, onko t\xE4m\xE4 totta..."
  textoPreEspejoParte2: "Mik\xE4 todistaa, ett\xE4 olet "
  textoPostEspejoParte2: 
  textoFeedbackCorrecto: "Olet oikeassa! T\xE4m\xE4 osoittaa, ett\xE4 olet todella "
  textoFeedbackCorrectoDetras: 
  textoFeedbackIncorrectoParte1: "Hmm... ehk\xE4 et olekaan niin "
  textoFeedbackIncorrectoParte2: "kuin luulit. N\xE4in k\xE4y meille kaikille joskus... "
  espejos:
  - nombre: Pelokas
    respuestaCorrecta: Uudet asiat pelottavat minua.
    respuestaIncorrecta: "Minua j\xE4nnitt\xE4\xE4, kun tapaan uusia ihmisi\xE4. "
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: "My\xF6nteinen"
    respuestaCorrecta: "Vaikeina hetkin\xE4 toivon, ett\xE4 kaikki menee hyvin. "
    respuestaIncorrecta: "Ajattelen, ettei mit\xE4\xE4n pahaa voi tapahtua."
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: "K\xE4rsim\xE4t\xF6n"
    respuestaCorrecta: "Teen asioita nopeasti miettim\xE4tt\xE4 seurauksia ."
    respuestaIncorrecta: "Joskus kadun, mit\xE4 sanon tai teen."
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Kokemuksille avoin
    respuestaCorrecta: "Tykk\xE4\xE4n kokeilla uusia juttuja"
    respuestaIncorrecta: "Tykk\xE4\xE4n tehd\xE4 asiat omalla tavallani."
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: "Miellytt\xE4mishaluinen"
    respuestaCorrecta: Teen usein niin kuin kaverit haluavat.
    respuestaIncorrecta: Minulle tulee paha mieli, jos joku suuttuu minulle.
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: "Itsen\xE4inen"
    respuestaCorrecta: "Tykk\xE4\xE4n olla ihmisten kanssa, mutta p\xE4rj\xE4\xE4n
      my\xF6s yksin."
    respuestaIncorrecta: Jos olen surullinen, haluan olla hetken yksin.
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Alisuorittaja
    respuestaCorrecta: "Minulla ei ole selkeit\xE4 tavoitteita el\xE4m\xE4ss\xE4."
    respuestaIncorrecta: "Joskus en tied\xE4, miten asiat pit\xE4isi tehd\xE4 oikein. "
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Itsevarma
    respuestaCorrecta: "Tykk\xE4\xE4n haasteista."
    respuestaIncorrecta: "Olen luopunut joistain asioista el\xE4m\xE4ss\xE4ni."
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: "Ep\xE4varma"
    respuestaCorrecta: "Jos jokin on vaikeaa, ajattelen etten selvi\xE4 siit\xE4."
    respuestaIncorrecta: "Tunnen oloni ep\xE4varmaksi, jos teen virheen. "
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Neuvokas
    respuestaCorrecta: "Tied\xE4n, mit\xE4 haluan el\xE4m\xE4lt\xE4 ja miksi."
    respuestaIncorrecta: Joskus tuntuu, ettei minulla ole vaihtoehtoja.
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Kiltti
    respuestaCorrecta: "Yrit\xE4n kohdella muita reilusti."
    respuestaIncorrecta: "Joskus en ymm\xE4rr\xE4, mit\xE4 muut ajattelevat."
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Vihainen
    respuestaCorrecta: Saatan kostaa niille, jotka ovat satuttaneet minua.
    respuestaIncorrecta: Voin joskus suuttua tosi paljon.
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Haaveilija
    respuestaCorrecta: "Uskon, ett\xE4 kaikki ihmiset ovat yht\xE4 arvokkaita."
    respuestaIncorrecta: Haaveilen paremmasta maailmasta, mutta se tuntuu joskus
      mahdottomalta.
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
  - nombre: Materiaalinen
    respuestaCorrecta: "Luotan vain siihen, mit\xE4 voin n\xE4hd\xE4."
    respuestaIncorrecta: "Tykk\xE4\xE4n saada lahjoja."
    figuraGeometrica: {fileID: 21300000, guid: e4a933647502b024da4ed14b8cbec31b, type: 3}
