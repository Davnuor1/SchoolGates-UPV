  m_Script: {fileID: 11500000, guid: e583b4c22b793db448789db36fb2579b, type: 3}
  m_Name: Espejos03_DE
  m_EditorClassIdentifier: 
  textoPreguntaInicial: Welche Menschen kennst Du, denen diese Werte genauso wichtig
    sind wie Dir?
  textoInstruccionesPrimeraFase: "Denk an ein sch\xF6nes oder bedeutendes Leben...
    Was brauchst Du wirklich? W\xE4hle den Spiegel aus, wenn Du ihn f\xFCr wichtig
    h\xE4ltst, oder zerbrich ihn, wenn Du ihn nicht brauchst"
  textoInstruccionesSegundaFase: "Du sagst also, dass diese Dinge f\xFCr Dich wichtig
    sind, aber wie sehr k\xFCmmerst Du dich wirklich darum? Wie viel Aufmerksamkeit
    und Zeit investierst Du wirklich in diese Dinge?"
  textoValoracion: "Sch\xE4tze die Bedeutung dieser Dinge f\xFCr Dich ein"
  textoCuidadoValores: "Was k\xF6nntest Du jetzt tun, um Dich mehr oder besser um
    Deine Werte zu k\xFCmmern?"
  textoAccionFinal: 
  espejos:
  - nombre: "Unabh\xE4ngigkeit"
    respuestas:
    - Meine eigenen Entscheidungen treffen
    - "Ein gewisses Ma\xDF an Kontrolle \xFCber mein Leben zu haben "
    - 'In der Lage sein, mein eigenes Geld zu verdienen und zu verwalten '
  - nombre: Freundschaften und soziale Beziehungen
    respuestas:
    - "Enge Freunde zu haben, mit denen ich meine Gedanken und Gef\xFChle teilen
      kann"
    - Zeit mit meinen Freunden zu verbringen
    - 'In einer romantischen Beziehung zu sein '
    - Viele Follower in den sozialen Medien zu haben
    - Beteiligung an einer sozialen Gemeinschaft und an globalen Projekten
  - nombre: "Suche nach Identit\xE4t"
    respuestas:
    - "Meine eigene Identit\xE4t erforschen und ausdr\xFCcken k\xF6nnen"
    - "Die Kleidung tragen, die ich mag, meine Lieblingsmusik h\xF6ren, wann immer
      ich will "
    - Neue Dinge ausprobieren, neue Lebenserfahrungen machen
    - Reisen
  - nombre: "Hobbys/Interessen, Privatsph\xE4re"
    respuestas:
    - "Sich mit Kunst, Musik oder Schreiben besch\xE4ftigen"
    - "Zeit f\xFCr meine Hobbys oder Interessen zu haben"
    - "Gen\xFCgend Privatsph\xE4re und meinen eigenen pers\xF6nlichen Raum zu haben"
    - Zeit haben, um mich den Dingen zu widmen, die ich mag
  - nombre: Familie und Zuhause
    respuestas:
    - "Eine Familie zu haben, die mich unterst\xFCtzt"
    - "Eine Familie zu haben, die mir zuh\xF6rt"
    - Zeit mit meiner Familie zu verbringen
    - "Sich zu Hause sicher f\xFChlen"
  - nombre: Bildung und Schule
    respuestas:
    - In der Schule gute Noten zu bekommen
    - In der Schule Dinge lernen, die sinnvoll sind
    - "Die F\xE4cher/Berufe w\xE4hlen, die ich mag"
    - In der Schule beliebt zu sein
  - nombre: Fitness und Gesundheit
    respuestas:
    - "Regelm\xE4\xDFig Sport zu treiben"
    - "Sich gesund zu ern\xE4hren"
    - Ausreichend zu schlafen
    - Meine Gesundheit und mein Wohlbefinden zu verbessern
