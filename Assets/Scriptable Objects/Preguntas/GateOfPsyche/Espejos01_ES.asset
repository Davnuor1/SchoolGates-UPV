%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 457a34b01ea1a0147ac69562ed6959ec, type: 3}
  m_Name: Espejos01_ES
  m_EditorClassIdentifier: 
  textoPreguntaInicial: "Elige los espejos con los que te identifiques y rompe los
    dem\xE1s."
  textoPreguntaRating: "Valora del 1 al 10 cu\xE1nto te identificas con este espejo."
  textoPreguntaParte2: "Veamos lo real que es... \xBFEres realmente t\xFA?"
  textoPreEspejoParte2: "Cu\xE1l es una prueba real de ser"
  textoPostEspejoParte2: 
  textoFeedbackCorrecto: "Tienes raz\xF3n\u2026 esto probablemente demuestra que
    eres "
  textoFeedbackCorrectoDetras: 
  textoFeedbackIncorrectoParte1: "Quiz\xE1 no eres tan"
  textoFeedbackIncorrectoParte2: como piensas... Esto le sucede a todo el mundo de
    vez en cuando...
  espejos:
  - nombre: 'Temeroso/a / Ansioso/a '
    respuestaCorrecta: Me asustan las cosas nuevas
    respuestaIncorrecta: Me pongo nervioso cuando conozco a gente nueva
  - nombre: Optimista
    respuestaCorrecta: "En tiempos dif\xEDciles tiendo a esperar lo mejor"
    respuestaIncorrecta: No puede ocurrirme nada malo
  - nombre: 'Impulsivo/a '
    respuestaCorrecta: No suelo pensar en las consecuencias de lo que digo o hago
    respuestaIncorrecta: ' A veces me arrepiento de algo que he dicho o hecho'
  - nombre: Abierto/a a experimentar
    respuestaCorrecta: Me gusta probar cosas nuevas
    respuestaIncorrecta: Me gusta hacer las cosas a mi manera
  - nombre: "n busca de aprobaci\xF3n o dependiente"
    respuestaCorrecta: Suelo hacer lo que mis amigos quieren que haga.
    respuestaIncorrecta: No me siento bien cuando alguien se enfada conmigo.
  - nombre: Independiente
    respuestaCorrecta: ' Me gusta pasar tiempo con gente, pero no me importa hacer
      cosas por mi cuenta'
    respuestaIncorrecta: Si estoy disgustado, prefiero estar solo
  - nombre: "Poco exigente con uno m\xEDsmo "
    respuestaCorrecta: No tengo objetivos claros en mi vida
    respuestaIncorrecta: "A veces dudo de m\xED mismo y de la mejor manera de realizar
      la tarea"
  - nombre: 'Decidido/a '
    respuestaCorrecta: Me motivan las tareas desafiantes
    respuestaIncorrecta: He renunciado a algunas cosas en mi vida
  - nombre: Culpabilidad / Inseguridad
    respuestaCorrecta: "Me siento incompetente cuando me enfrento a obst\xE1culos
      y dificultades"
    respuestaIncorrecta: Me siento inseguro cuando hago las cosas mal
  - nombre: 'Resolutivo/a '
    respuestaCorrecta: "Siento que mi vida tiene un sentido y una direcci\xF3n claros"
    respuestaIncorrecta: "No siempre siento que tengo elecci\xF3n"
  - nombre: "Emp\xE1tico/a / Amable "
    respuestaCorrecta: Intento tratar a la gente de manera justa
    respuestaIncorrecta: A veces no entiendo a la gente que me rodea
  - nombre: Hostil
    respuestaCorrecta: "Tiendo a vengarme de los que me han hecho da\xF1o"
    respuestaIncorrecta: En ocasiones me enfado mucho
  - nombre: Esperanzador o Idealista
    respuestaCorrecta: Creo que todos somos iguales
    respuestaIncorrecta: A veces dudo de que un mundo mejor sea posible
  - nombre: Materialista
    respuestaCorrecta: "S\xF3lo creo en lo que veo"
    respuestaIncorrecta: Me gusta que me hagan regalos
