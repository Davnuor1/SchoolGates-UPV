MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12378fb498d283642a330e1ccd91f0bf, type: 3}
  m_Name: EspejosExterior_FI
  m_EditorClassIdentifier: 
  topMessageInitial: "M\xE4rehtij\xE4 esitt\xE4\xE4 sinulle kysymyksen... Uskallatko
    vastata?"
  topMessageRespondFormat: "Miten vastaat m\xE4rehtij\xE4lle nimelt\xE4  {0 }"
  topMessageSecondRound: "Mit\xE4 muuta voisit sanoa heille?"
  buttonRepeatText: Toista
  buttonRespondText: Vastaa
  espejos:
  - mirrorTitle: Menestys
    mirrorText: "Minun pit\xE4\xE4 aina onnistua, muuten olen ep\xE4onnistuja."
    responses:
    - "Joskus ep\xE4onnistun, mutta se ei tee minusta huonoa."
    - "Virheist\xE4 oppii \u2013 ne kuuluvat onnistumiseen."
    - Kukaan ei voi olla paras kaikessa.
  - mirrorTitle: "Syytt\xE4m\xE4ll\xE4"
    mirrorText: "Kaikki on minun syyt\xE4ni. En ansaitse olla onnellinen."
    responses:
    - 'Ansaitsen olla onnellinen, ihan niin kuin kaikki muutkin. '
    - "Teen joskus virheit\xE4, mutta voin aina yritt\xE4\xE4 uudelleen"
    - "Olen yht\xE4 arvokas kuin muut. "
  - mirrorTitle: Ihanteellinen vartalo
    mirrorText: "Vartaloni ei ole tarpeeksi hyv\xE4. Sen pit\xE4isi olla t\xE4ydellinen."
    responses:
    - "Vartaloni on hyv\xE4 juuri t\xE4llaisena, riippumatta siit\xE4, mit\xE4 muut
      ihmiset sanovat. "
    - 'Olen kaunis ja vahva omalla tavallani. '
    - "T\xE4ydellist\xE4 vartaloa ei ole olemassa."
  - mirrorTitle: Kateus
    mirrorText: "Kaikki muut ovat parempia kuin min\xE4 ja heill\xE4 on asiat paremmin
      kuin minulla."
    responses:
    - "Kaikilla on erilaisia \u200B\u200Bhyvi\xE4 ja huonoja puolia."
    - "Meill\xE4 jokaisella on pelkoja ja ongelmia."
    - "En ehk\xE4 saa kaikkea, mutta minulla on paljon hyv\xE4\xE4, josta voin olla
      kiitollinen. "
  - mirrorTitle: Itsesabotaasi
    mirrorText: "Min\xE4 en riit\xE4. En tule koskaan onnistumaan."
    responses:
    - Vaikka mokaan joskus, voin silti onnistua.
    - "Joskus voitan, joskus en \u2013 ja se on ihan ok."
    - "Yrit\xE4n parhaani, ja se on t\xE4rkeint\xE4."
