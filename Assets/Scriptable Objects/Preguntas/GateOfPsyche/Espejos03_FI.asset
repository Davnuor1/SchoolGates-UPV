  m_Script: {fileID: 11500000, guid: e583b4c22b793db448789db36fb2579b, type: 3}
  m_Name: Espejos03_FI
  m_EditorClassIdentifier: 
  textoPreguntaInicial: "Kuka muu v\xE4litt\xE4\xE4 t\xE4st\xE4 yht\xE4 paljon kuin
    sin\xE4?"
  textoInstruccionesPrimeraFase: "Ajattele hyvi\xE4 ja t\xE4rkeit\xE4 asioita el\xE4m\xE4ss\xE4\u2026
    Valitse, mit\xE4 arvostat eniten."
  textoInstruccionesSegundaFase: "Kuinka t\xE4rke\xE4\xE4 t\xE4m\xE4 on sinulle?
    Kuinka paljon aikaa ja huomiota annat sille?"
  textoValoracion: "Arvioi n\xE4iden asioiden merkitys itsellesi"
  textoCuidadoValores: "Mit\xE4 voisit tehd\xE4 huolehtiaksesi paremmin siit\xE4,
    mik\xE4 sinulle todella merkitsee?"
  textoAccionFinal: 
  espejos:
  - nombre: "Itsen\xE4isyys"
    respuestas:
    - "Saan tehd\xE4 omia p\xE4\xE4t\xF6ksi\xE4"
    - "Voin vaikuttaa omaan el\xE4m\xE4\xE4ni"
    - "Opin k\xE4ytt\xE4m\xE4\xE4n ja s\xE4\xE4st\xE4m\xE4\xE4n rahaa itse"
  - nombre: "Yst\xE4vyydet ja sosiaaliset suhteet"
    respuestas:
    - "Minulla on l\xE4heisi\xE4 yst\xE4vi\xE4, joille voin kertoa ajatuksiani ja
      tunteitani"
    - "Viet\xE4mme aikaa yhdess\xE4 yst\xE4vien kanssa"
    - Olen ihastunut tai seurustelen
    - Minulla on paljon seuraajia somessa.
    - " Olen mukana ryhm\xE4ss\xE4 tai kampanjassa, joka tekee hyv\xE4\xE4 maailmalle."
  - nombre: Oman minuuden etsiminen
    respuestas:
    - "Saan tutkia ja n\xE4ytt\xE4\xE4, kuka oikeasti olen"
    - Voin pukeutua kuten haluan ja kuunnella lempimusiikkiani.
    - Kokeilen uusia asioita ja kokemuksia.
    - "P\xE4\xE4sen matkustamaan."
  - nombre: Harrastukset ja oma rauha
    respuestas:
    - Teen taidetta, musiikkia tai kirjoitan .
    - Minulla on aikaa harrastuksille ja kiinnostuksen kohteille
    - Minulla on oma rauha ja tila.
  - nombre: Perhe ja koti
    respuestas:
    - Minulla on perhe, joka tukee minua
    - Perheeni kuuntelee minua
    - "Viet\xE4mme aikaa yhdess\xE4 perheen kanssa"
    - 'Tunnen oloni turvalliseksi kotona '
  - nombre: Koulu ja oppiminen
    respuestas:
    - "Saan hyvi\xE4 arvosanoja koulussa"
    - "Opin t\xE4rkeit\xE4 asioita"
    - Voin valita aineita tai tulevan ammatin, joka kiinnostaa minua
    - Olen suosittu koulussa
  - nombre: Terveys ja hyvinvointi
    respuestas:
    - "Liikun s\xE4\xE4nn\xF6llisesti"
    - "Sy\xF6n terveellisesti"
    - Nukun tarpeeksi
    - Voin parantaa omaa oloani ja jaksamistani
