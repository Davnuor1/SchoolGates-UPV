MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12378fb498d283642a330e1ccd91f0bf, type: 3}
  m_Name: EspejosExterior_DE
  m_EditorClassIdentifier: 
  topMessageInitial: "Reagiere auf diesen D\xE4mon, wenn Du vorankommen willst..."
  topMessageRespondFormat: "Wie reagierst Du auf den D\xE4mon/Gegenspieler von {0}?"
  topMessageSecondRound: "Was k\xF6nntest Du ihnen noch sagen?"
  buttonRepeatText: Wiederholen
  buttonRespondText: Antwort
  espejos:
  - mirrorTitle: Erfolgs
    mirrorText: Man muss in allem, was man tut, erfolgreich sein, sonst ist man ein
      Verlierer
    responses:
    - 'Ich gewinne nicht immer, aber das macht mich nicht zu einem Verlierer '
    - 'Fehler zu machen ist Teil des Erfolgs '
    - Niemand kann in allem der Beste sein
  - mirrorTitle: Schuldzuweisung
    mirrorText: "Du bist selbst schuld, Du verdienst es nicht, gl\xFCcklich zu sein"
    responses:
    - "Jeder verdient die Chance, gl\xFCcklich zu sein"
    - Menschen machen manchmal Fehler, aber sie haben immer eine zweite Chance verdient
    - Ich bin nicht weniger oder mehr als jeder andere
  - mirrorTitle: "Idealen K\xF6rpers"
    mirrorText: "Dein K\xF6rper ist nicht perfekt, aber das muss er sein "
    responses:
    - "Mein K\xF6rper ist perfekt, so wie er ist, egal, was andere Leute sagen"
    - "Ich bin sch\xF6n und stark"
    - "Den perfekten K\xF6rper gibt es nicht"
  - mirrorTitle: Neids
    mirrorText: Alle sind besser als Du und haben bessere Dinge als Du
    responses:
    - "Unterschiedliche Menschen haben unterschiedliche St\xE4rken und Schw\xE4chen"
    - "Jeder hat seine eigenen \xC4ngste und Probleme"
    - "Ich habe nicht alles, was ich will, aber ich bin dankbar f\xFCr das, was ich
      habe"
  - mirrorTitle: Selbstsabotage
    mirrorText: Du bist nicht genug, Du wirst nie gewinnen
    responses:
    - Auch wenn ich manchmal falsch liege, kann ich Dinge richtig machen
    - Du gewinnst nicht immer und du verlierst nicht immer
    - Wenigstens kann ich mein Bestes geben und das ist es wert
