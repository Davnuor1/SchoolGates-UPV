  m_Name: Cinematic_Gate01_DE
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1751215814, guid: 9a58ea4a2fcecee4290b0f42dc7ed74e, type: 3}
    text: "Du  sind dabei, eine h\xF6hlenartige Welt zu betrittst, die Dein eigenes
      Bewusstsein darstellt..."
  - image: {fileID: -1901202311, guid: 9a58ea4a2fcecee4290b0f42dc7ed74e, type: 3}
    text: "Du musst dir mit unglaublichem Einfallsreichtum einen Weg durch die magischen
      Kristalle bahnen und zu den Spiegelpr\xFCfungen gelangen..."
  - image: {fileID: -1473104871, guid: 9a58ea4a2fcecee4290b0f42dc7ed74e, type: 3}
    text: "Dann \xFCberwindest du den Pfad durch die Klippen und triffst auf die
      D\xE4monen... die vielleicht nicht so aussehen, wie sie sind..."
  - image: {fileID: 953630571, guid: 9a58ea4a2fcecee4290b0f42dc7ed74e, type: 3}
    text: "Und so kommst du zum Lagerfeuer der Konfrontation, wo du einen gro\xDFen
      Unterschied machen kannst...."
  nextButtonText: Weiter
