  m_Name: Cinematic_Gate03_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1075106435, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Koulun ulkopuolella on muitakin maailmoja. Mutta my\xF6s t\xE4\xE4ll\xE4
      pimeys levi\xE4\xE4 ja peitt\xE4\xE4 jopa tiedon paikan."
  - image: {fileID: -828262581, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Tiet\xE4myksen ytimess\xE4 suuret alat ovat erill\xE4\xE4n. Viisaus, joka
      ennen yhdisti ne, on hajonnut."
  - image: {fileID: 2012432809, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "T\xE4m\xE4n sekasorron keskell\xE4 etsi Ajattelevien taloa \u2013 paikkaa,
      jossa totuus voi viel\xE4 l\xF6yty\xE4."
  - image: {fileID: 1388162980, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "T\xE4ss\xE4 on avain. Luo kaava robotin avulla ja korjaa ihmiskunnan palapeli.
      T\xE4ydenn\xE4 se\u2026 ja onnea matkaan!"
  nextButtonText: Seuraava
