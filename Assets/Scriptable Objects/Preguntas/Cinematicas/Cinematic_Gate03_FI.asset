  m_Name: Cinematic_Gate03_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1075106435, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Koulun lis\xE4ksi on my\xF6s muita maailmoja, jotka ovat syv\xE4ss\xE4
      ja huolestuttavassa pimeydess\xE4."
  - image: {fileID: -828262581, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Tiedon keski\xF6ss\xE4 viisi suurta erikoisalaa ovat vastakkain, mik\xE4
      h\xE4iritsee perustietoa."
  - image: {fileID: 2012432809, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "T\xE4m\xE4n masentavan tilanteen edess\xE4 etsi tietoa, joka sijaitsee
      puolueettomassa yhteyspisteess\xE4, jota kutsutaan kriittisten ajattelijoiden
      rakennukseksi."
  - image: {fileID: 1388162980, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Siell\xE4 l\xF6yd\xE4t kaiken tarvitsemasi, jotta voit liitty\xE4 eri
      ryhmittymiin ja koota ihmiskunnan palapelin palaset...  Onnea matkaan..."
  nextButtonText: Seuraava
