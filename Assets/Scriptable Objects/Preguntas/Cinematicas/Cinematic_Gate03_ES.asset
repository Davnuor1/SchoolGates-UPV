  m_Name: Cinematic_Gate03_ES
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1075106435, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Adem\xE1s de la escuela, hay otros mundos que tambi\xE9n se encuentran
      en una profunda e inquietante oscuridad"
  - image: {fileID: -828262581, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "En el lugar m\xE1s central del conocimiento, las 5 grandes especialidades
      est\xE1n enfrentadas entre s\xED, perturbando el conocimiento primordial."
  - image: {fileID: 2012432809, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Ante esta descorazonadora situaci\xF3n, busca el conocimiento, situado
      en el nexo imparcial, llamado edificio de los pensadores cr\xEDticos."
  - image: {fileID: 1388162980, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "En \xE9l, encontrar\xE1s lo que necesitas para entrar en las diferentes
      facciones y poder reconstruir el puzzle de la humanidad...  Buena suerte..."
  nextButtonText: Next
