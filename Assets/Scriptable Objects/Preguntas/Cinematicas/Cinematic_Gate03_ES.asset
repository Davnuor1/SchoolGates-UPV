  m_Script: {fileID: 11500000, guid: c3830def2b6bbf848807d7aea15f27b5, type: 3}
  m_Name: Cinematic_Gate03_ES
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1075106435, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "M\xE1s all\xE1 de la escuela existen otros mundos. Pero aqu\xED tambi\xE9n
      la oscuridad se extiende, cubriendo incluso el lugar del conocimiento."
  - image: {fileID: -828262581, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "En el coraz\xF3n del conocimiento, las grandes disciplinas est\xE1n divididas.
      La sabidur\xEDa que una vez las uni\xF3 se ha roto."
  - image: {fileID: 2012432809, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "En medio de este desorden, busca la Casa de los Pensadores Cr\xEDticos
      \u2014 un lugar donde a\xFAn puede encontrarse la verdad."
  - image: {fileID: 1388162980, guid: 522453d83bd1cf044a50cebe1de2fba5, type: 3}
    text: "Aqu\xED yace la clave. Con la ayuda del robot, crea la f\xF3rmula para
      restaurar el rompecabezas de la humanidad. Compl\xE9tala\u2026 y buena suerte."
  nextButtonText: Siguiente
