  m_Name: Cinematic_Final4_DE
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: 1951639049, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Du hast es geschafft, Du konntest nach einem  langen und beschwerlichen
      Weg alles Positive in der Welt zur\xFCckgewinnen."
  - image: {fileID: 1831015359, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Der Baum der Seele bl\xFCht wieder auf und symbolisiert die wiedergewonnene
      Hoffnung und die strahlende Zukunft..."
  - image: {fileID: -116059307, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Das b\xF6se Monster hat keinen Hass mehr in sich, es hat all die Bosheit
      verloren, die von den schlechten Gef\xFChlen des ganzen Planeten herr\xFChrt..."
  - image: {fileID: -1546845187, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Jetzt kannst Du Deinen neuen Lebensabschnitt wirklich beginnen und mit
      all dem, was Du gelernt hast ein besserer Mensch werden\u2026"
  nextButtonText: Weiter
