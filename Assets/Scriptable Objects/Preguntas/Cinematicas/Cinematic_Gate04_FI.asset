  m_Name: Cinematic_Gate04_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1870357709, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: Olet saapunut Tunteiden Labyrinttiin, joka on piilossa oudossa kaupungissa.
      Kaupunki ei ole parhaassa kunnossa.
  - image: {fileID: 324211567, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "T\xE4\xE4ll\xE4 kohtaat erilaisia tunnehaasteita. Miten selvi\xE4t niist\xE4?"
  - image: {fileID: -1018484990, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Matkasi varrella tulet n\xE4kem\xE4\xE4n kauas ja ymm\xE4rt\xE4m\xE4\xE4n
      syvemmin tunteitasi. T\xE4m\xE4 oivallus on avain eteenp\xE4in."
  - image: {fileID: 1045627247, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Matkan j\xE4lkeen saavut labyrintin syd\xE4meen, jossa voit n\xE4ytt\xE4\xE4,
      mit\xE4 olet oppinut."
  nextButtonText: Seuraava
