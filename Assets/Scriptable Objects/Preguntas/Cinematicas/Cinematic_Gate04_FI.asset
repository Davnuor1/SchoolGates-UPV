  m_Script: {fileID: 11500000, guid: c3830def2b6bbf848807d7aea15f27b5, type: 3}
  m_Name: Cinematic_Gate04_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1870357709, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: Olet saapunut tunteiden labyrinttiin... joka sijaitsee futuristisessa kaupungissa,
      joka ei ole parhaassa kunnossa.
  - image: {fileID: 324211567, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "T\xE4\xE4ll\xE4 sinun on selvitett\xE4v\xE4 useita j\xE4nnittyneit\xE4
      tilanteita saadaksesi tarvittavan tiedon..."
  - image: {fileID: -1018484990, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Astraalitaso on sinulle suureksi avuksi matkallasi kohti tunteiden ymm\xE4rt\xE4mist\xE4,
      hy\xF6dynn\xE4 sit\xE4."
  - image: {fileID: 1045627247, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Vaikean matkan j\xE4lkeen saavut labyrintin keskelle, jossa l\xF6yd\xE4t
      tarvitsemasi vastaukset..."
  nextButtonText: Seuraava
