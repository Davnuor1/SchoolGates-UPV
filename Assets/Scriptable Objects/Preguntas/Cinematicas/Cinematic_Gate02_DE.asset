  m_Name: Cinematic_Gate02_DE
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: 75755818, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Du gelangst in eine Art Sumpf, feucht und tr\xFCbe, Wasserfl\xE4chen und
      Schlickfl\xE4chen tauchen vor dir auf."
  - image: {fileID: 1781549058, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Es wird von b\xF6sen Kreaturen namens \u201EMaligores\u201C bewohnt, die
      die Reinkarnation von Hass und Finsternis zu sein scheinen."
  - image: {fileID: -1776100737, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Du musst zur H\xFCtte der Weisen auf der Spitze des H\xFCgels gehen, um
      eine L\xF6sung f\xFCr das Problem zu finden."
  - image: {fileID: -70268668, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Um dorthin zu gelangen, must Du den Menschen vor Ort helfen, indem Du
      drei Pr\xFCfungen \xFCberwindest: das Labyrinth des Hungers, den Fluss der
      Fl\xFCchtlinge und den Berg der Ungleichheiten."
  nextButtonText: Weiter
