  m_Name: Cinematic_Final4_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -201972919, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Sin\xE4 teit sen, sin\xE4 sait takaisin kaikki maailman positiiviset asiat,
      pitk\xE4n ja vaivalloisen matkan j\xE4lkeen."
  - image: {fileID: 1200660681, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Sielun puu kukkii j\xE4lleen, symboloiden palautunutta toivoa ja loistavaa
      tulevaisuutta... "
  - image: {fileID: 151312958, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Paha hirvi\xF6 ei en\xE4\xE4 tunne vihaa sis\xE4ll\xE4\xE4n, se on menett\xE4nyt
      kaiken pahuuden, joka johtui koko planeetan pahoista tunteista..."
  - image: {fileID: -1875225413, guid: 22212bbef61a56941af22e4a8ee82db7, type: 3}
    text: "Nyt voit todella aloittaa uuden el\xE4m\xE4nvaiheen. Kaiken oppimasi ansiosta
      sinusta tulee varmasti parempi ihminen... "
  nextButtonText: Seuraava
