  m_Name: Cinematic_Gate02_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: 75755818, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Saavut synk\xE4lle suolle. Siell\xE4 on vett\xE4, mutaa ja sumua."
  - image: {fileID: 1781549058, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "T\xE4\xE4ll\xE4 asuu outoja ja pelottavia olentoja, joita kutsutaan Maligoreiksi.
      Sinun t\xE4ytyy paeta niit\xE4\u2026 mutta ovatko ne oikeasti vihollisia?"
  - image: {fileID: -1776100737, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Teht\xE4v\xE4si on p\xE4\xE4st\xE4 viisaiden vanhusten m\xF6kille kukkulan
      huipulla. Siell\xE4 on turvallista."
  - image: {fileID: -70268668, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Jotta p\xE4\xE4sisit sinne, sinun t\xE4ytyy auttaa paikallisia ihmisi\xE4
      suorittamalla kolme koetta: N\xE4l\xE4n sokkelo, Pakolaisten joki ja Ep\xE4tasa-arvon
      kukkula."
  nextButtonText: Seuraava
