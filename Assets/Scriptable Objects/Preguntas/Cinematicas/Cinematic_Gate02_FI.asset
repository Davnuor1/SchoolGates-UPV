  m_Name: Cinematic_Gate02_FI
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: 75755818, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Saavut er\xE4\xE4nlaiseen suohon, joka on kostea ja samea, ja edess\xE4si
      avautuu vesialueita ja mutaa."
  - image: {fileID: 1781549058, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Siell\xE4 asuu pahoja olentoja, joita kutsutaan nimell\xE4 \u201DMaligores\u201D
      ja jotka n\xE4ytt\xE4v\xE4t olevan vihan ja synkkyyden reinkarnaatioita."
  - image: {fileID: -1776100737, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "Sinun t\xE4ytyy menn\xE4 viisaiden miesten majalle, joka sijaitsee kukkulan
      huipulla, l\xF6yt\xE4\xE4ksesi ratkaisun ongelmaan."
  - image: {fileID: -70268668, guid: 3005a11dba33d9542a3c90bd1d1190d2, type: 3}
    text: "P\xE4\xE4st\xE4ksesi sinne sinun on autettava paikallisia ihmisi\xE4 selviytym\xE4ll\xE4
      kolmesta koettelemuksesta: n\xE4l\xE4n labyrintist\xE4, pakolaisten joesta
      ja eriarvoisuuden kukkulasta."
  nextButtonText: Seuraava
