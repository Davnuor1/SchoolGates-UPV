  m_Name: Cinematic_Gate04_DE
  m_EditorClassIdentifier: 
  vignettes:
  - image: {fileID: -1870357709, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Du bist im Labyrinth der Gef\xFChle angekommen... in einer futuristischen
      Stadt, die sich nicht im besten Zustand befindet."
  - image: {fileID: 324211567, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Hier musst du dich durch verschiedene emotionsgeladene Situationen k\xE4mpfen,
      um das n\xF6tige Wissen zu erlangen...."
  - image: {fileID: -1018484990, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Die Astralebene wird Dir auf Deinem Weg zum Verst\xE4ndnis der Gef\xFChle
      eine gro\xDFe Hilfe sein, nutze sie!"
  - image: {fileID: 1045627247, guid: dda96eb34db6a414da24e64d6f8f452c, type: 3}
    text: "Nach der beschwerlichen Reise erreichst Du das Zentrum des Labyrinths,
      wo Du die n\xF6tigen Antworten finden wirst\u2026"
  nextButtonText: Weiter
