%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9becf7d9ed3e4454db5aa56b7345d9f1, type: 3}
  m_Name: AgoraCH2Localization_IT
  m_EditorClassIdentifier: 
  chests:
  - chestID: Arte
    chestImage: {fileID: -566849752, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Fantastico! Questa \xE8 una verit\xE0 che viene da..."
    textClueAgora: "Per acquisire la vera saggezza, devi ricordare che c\u2019\xE8
      sempre pi\xF9 di un punto di vista su quale sia la verit\xE0\u2026 Alcune verit\xE0
      della vita sono solo basate su consuetudini, emozioni o intuizioni. Le arti
      parlano di questo tipo di verit\xE0. Ad esempio, quando Gata Cattana, poetessa
      e rapper spagnola, dice \u201CI ricchi e i poveri non amano allo stesso modo\u201D,
      non sta presentando un semplice fatto, ma uno stato d\u2019animo e una dichiarazione
      di intenti"
    altarNumber: 2
  - chestID: Historia
    chestImage: {fileID: 394024147, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Fantastico! Questa \xE8 una verit\xE0 che viene da..."
    textClueAgora: "Per acquisire la vera saggezza, avrai bisogno di 4 parti di congruenza
      . La congruenza si riferisce al fatto che queste informazioni corrispondano
      alla realt\xE0. Controlla sempre la realt\xE0 per vedere se le informazioni
      sono vere. Ad esempio, se sei attento alla salute e decidi di acquistare una
      nuova marca di cereali per la colazione che dichiara di essere composta interamente
      da ingredienti biologici, puoi verificare questa affermazione. Ricerca il marchio
      e conferma l'autenticit\xE0 della certificazione biologica per garantire che
      le informazioni siano coerenti con la realt\xE0. Ci\xF2 ti aiuter\xE0 a sviluppare
      il tuo pensiero critico e la tua capacit\xE0 di raccogliere, ordinare e filtrare
      le informazioni."
    altarNumber: 4
  - chestID: Mates
    chestImage: {fileID: -950423340, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Fantastico! Questa \xE8 una verit\xE0 che viene da..."
    textClueAgora: "Per acquisire la vera saggezza, avrai bisogno di 3 parti di coerenza
      . Si riferisce al fatto che l\u2019informazione sia coerente con altre verit\xE0.
      Ad esempio, nel processo di decisione su un futuro percorso professionale,
      valuta attentamente i tuoi interessi personali, i tuoi valori e gli obiettivi
      a lungo termine per decidere in modo coerente con essi. Queste azioni porteranno
      a sviluppare il pensiero critico nelle tue scelte di vita.!"
    altarNumber: 3
  - chestID: Ciencia
    chestImage: {fileID: -244741445, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Fantastico! Questa \xE8 una verit\xE0 che viene da..."
    textClueAgora: "Per acquisire la vera saggezza, avrai bisogno di 5 evidenze .
      Le evidenze sono prove o fatti oggettivi, che non sono discutibili perch\xE9
      tutti possiamo osservarli. Ad esempio, il riscaldamento globale \xE8 un fenomeno
      supportato da molteplici evidenze e un impatto osservabile \xE8 lo scioglimento
      dei ghiacciai mostrato dalle immagini satellitari e dalle fotografie scattate
      nel tempo. Per comprendere una situazione e sapere se un fenomeno \xE8 vero,
      bisogna prima raccogliere i fatti e, poi, riflettere criticamente sulla questione"
    altarNumber: 5
  - chestID: Humanidades
    chestImage: {fileID: 1253979381, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Fantastico! Questa \xE8 una verit\xE0 che viene da..."
    textClueAgora: "Per acquisire la vera saggezza, avrai bisogno di 1 parte di utilit\xE0
      e 2 parti di fonti originali/affidabili. L'utilit\xE0 si riferisce alla qualit\xE0
      di un'informazione rispetto a un obiettivo. Ad esempio, conoscere le potenziali
      conseguenze della condivisione di determinati contenuti sui social media \xE8
      utile per proteggersi da esperienze dannose. La ricerca della fonte originaria
      \xE8 la via per trovare la verit\xE0 di un'esperienza soggettiva. Ad esempio,
      se vuoi sapere come si sente qualcuno, \xE8 meglio chiederglielo direttamente
      piuttosto che indovinare o chiedere agli altri. "
    altarNumber: 1
  fusionErrorText: "Attenzione, qualcosa non funziona\u2026"
  fusionSuccessText: "Ognuno \xE8 importante e pu\xF2 fare la differenza se segue
    la strada della saggezza... Ecco perch\xE9 il puzzle rimane incompleto, perch\xE9
    ognuno deve fare la sua parte: decidere come vivere e per cosa vivere...."
