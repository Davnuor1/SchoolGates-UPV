%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9becf7d9ed3e4454db5aa56b7345d9f1, type: 3}
  m_Name: AgoraCH2Localization_DE
  m_EditorClassIdentifier: 
  chests:
  - chestID: Arte
    chestImage: {fileID: -566849752, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Gro\xDFartig! Das ist ein echtes St\xFCck Arbeit"
    textClueAgora: "Um wahre Weisheit zu erlangen, musst Du daran denken, dass es
      immer mehr als einen Blickwinkel auf die Wahrheit gibt\u2026 Manche Wahrheiten
      des Lebens sind einfach Br\xE4uche, sie sind emotional oder intuitiv begr\xFCndet.
      Die Kunst kann solche Wahrheiten vermitteln. Zum Beispiel, wenn Gata Cattana,
      eine spanische Dichterin und Rapperin, sagt: \u201EDie Reichen und die Armen
      lieben nicht gleicherma\xDFen\u201C, stellt sie keinen einfachen Fakt dar,
      sondern einen Geisteszustand und eine Absichtserkl\xE4rung."
    altarNumber: 2
  - chestID: Historia
    chestImage: {fileID: 394024147, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Gro\xDFartig! Das ist ein echtes St\xFCck Arbeit"
    textClueAgora: "Um wahre Weisheit zu erlangen, brauchst Du 4 Teile \xDCbereinstimmung.
      \xDCbereinstimmung bedeutet, dass diese Informationen der Realit\xE4t entsprechen.
      \xDCberpr\xFCfe immer die Realit\xE4t, um festzustellen, ob die Informationen
      wahr sind. Wenn Du zum Beispiel gesundheitsbewusst bist und Dich entscheidest,
      eine neue Marke von Fr\xFChst\xFCcksflocken zu kaufen, die behauptet, vollst\xE4ndig
      aus biologischen Zutaten hergestellt zu sein, kannst Du diese Behauptung \xFCberpr\xFCfen.
      Recherchiere die Marke und best\xE4tige die Echtheit der Bio-Zertifizierung,
      um sicherzustellen, dass die Informationen mit der Realit\xE4t \xFCbereinstimmen.
      Dies wird Dir helfen, Dein kritisches Denken sowie Deine F\xE4higkeit, Informationen
      zu beschaffen, zu sortieren und zu filtern, zu entwickeln."
    altarNumber: 4
  - chestID: Mates
    chestImage: {fileID: -950423340, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Gro\xDFartig! Das ist ein echtes St\xFCck Arbeit"
    textClueAgora: "Um wahre Weisheit zu erlangen, brauchst Du 3 Teile Best\xE4ndigkeit.
      Best\xE4ndigkeit bedeutet, dass eine Information mit anderen Wahrheiten \xFCbereinstimmt.
      Zum Beispiel solltest Du bei der Entscheidung \xFCber Deinen zuk\xFCnftigen
      Karriereweg sorgf\xE4ltig Deine pers\xF6nlichen Interessen, Werte und langfristigen
      Ziele in \xDCbereinstimmung miteinander abw\xE4gen. Diese Handlungen werden
      dazu f\xFChren, dass Du kritisches Denken bei Deinen Lebensentscheidungen entwickelst. "
    altarNumber: 3
  - chestID: Ciencia
    chestImage: {fileID: -244741445, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Gro\xDFartig! Das ist ein echtes St\xFCck Arbeit"
    textClueAgora: "Um wahre Weisheit zu erlangen, brauchst Du 5 Beweise. Beweise
      sind Nachweise oder objektive Fakten, die nicht diskutierbar sind, weil wir
      sie alle beobachten k\xF6nnen. Zum Beispiel ist die globale Erw\xE4rmung ein
      Ph\xE4nomen, das durch mehrere Beweise gest\xFCtzt wird und eine beobachtbare
      Auswirkung ist das Schmelzen der Gletscher, das durch Satellitenbilder und
      Fotografien im Laufe der Zeit gezeigt wird. Um eine Situation zu verstehen
      und zu wissen, ob ein Ph\xE4nomen wahr ist, musst Du zuerst Fakten sammeln
      und dann kritisch \xFCber das Thema nachdenken."
    altarNumber: 5
  - chestID: Humanidades
    chestImage: {fileID: 1253979381, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Gro\xDFartig! Das ist ein echtes St\xFCck Arbeit"
    textClueAgora: "Um wahre Weisheit zu erlangen, brauchst Du 1 Teil N\xFCtzlichkeit
      und 2 Teile urspr\xFCngliche/zuverl\xE4ssige Quellen. N\xFCtzlichkeit bezieht
      sich auf die Qualit\xE4t einer Information in Bezug auf ein Ziel. Zum Beispiel
      ist es n\xFCtzlich zu wissen, welche potenziellen Konsequenzen das Teilen bestimmter
      Inhalte in sozialen Medien haben kann, um sich vor sch\xE4dlichen Erfahrungen
      zu sch\xFCtzen. Um die Wahrheit einer subjektiven Erfahrung zu finden, ist
      die Suche nach der urspr\xFCnglichen Quelle der beste Weg. Wenn Du zum Beispiel
      wissen m\xF6chtest, wie sich jemand f\xFChlt, ist es am besten, diese Person
      direkt zu fragen, anstatt zu raten oder andere zu fragen. "
    altarNumber: 1
  fusionErrorText: "Achtung, etwas funktioniert nicht\u2026"
  fusionSuccessText: "Jeder ist wichtig und kann etwas bewirken, wenn er dem Pfad
    der Weisheit folgt... Deshalb bleibt das Puzzle unvollst\xE4ndig, denn jeder
    muss seinen Teil dazu beitragen: entscheiden, wie er lebt und wof\xFCr er lebt..."
