%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9becf7d9ed3e4454db5aa56b7345d9f1, type: 3}
  m_Name: AgoraCH2Localization_FI
  m_EditorClassIdentifier: 
  chests:
  - chestID: Arte
    chestImage: {fileID: -566849752, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Viisauden saavuttamisessa pit\xE4\xE4 muistaa, ett\xE4 totuudesta
      voi olla monta n\xE4k\xF6kulmaa. Kaikki totuudet el\xE4m\xE4ss\xE4 eiv\xE4t
      ole faktoja \u2013 osa niist\xE4 perustuu tunteisiin, tapoihin tai vaistoon.
      Taide voi kertoa t\xE4llaisista totuuksista. Esimerkiksi espanjalainen runoilija
      ja r\xE4pp\xE4ri Gata Cattana sanoi: \"Rikkaat ja k\xF6yh\xE4t eiv\xE4t rakasta
      samalla tavalla.\" T\xE4m\xE4 ei ole pelkk\xE4 fakta, vaan ajatus ja tunne,
      joka kertoo h\xE4nen n\xE4kemyksest\xE4\xE4n maailmasta. "
    altarNumber: 2
  - chestID: Historia
    chestImage: {fileID: 394024147, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Jos haluat tulla viisaaksi, tarvitset nelj\xE4 yhtenev\xE4isyyden
      osaa. Se tarkoittaa, ett\xE4 tiedon pit\xE4\xE4 vastata sit\xE4, mit\xE4 oikeasti
      tapahtuu tai on olemassa. Esimerkiksi jos haluat sy\xF6d\xE4 terveellisesti
      ja ostat muroja, joissa lukee \"luomu\", tarkista tuotemerkki ja sen sertifiointi
      varmistaaksesi, ett\xE4 v\xE4ite on paikkansapit\xE4v\xE4. T\xE4m\xE4 auttaa
      sinua kehitt\xE4m\xE4\xE4n kriittist\xE4 ajattelua ja kyky\xE4si ker\xE4t\xE4,
      lajitella ja suodattaa tietoa."
    altarNumber: 4
  - chestID: Mates
    chestImage: {fileID: -950423340, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "os haluat tulla todella viisaaksi, tarvitset kolme osaa johdonmukaisuutta.
      Se tarkoittaa, ett\xE4 tiedon pit\xE4\xE4 sopia yhteen muiden totuuksien kanssa.
      Esimerkiksi kun mietit, mik\xE4 ammatti sinulle sopisi, kannattaa mietti\xE4
      omia mieltymyksi\xE4si, arvojasi ja tavoitteitasi. T\xE4llainen ajattelu auttaa
      sinua kehitt\xE4m\xE4\xE4n taitoa tehd\xE4 hyvi\xE4 valintoja el\xE4m\xE4ss\xE4."
    altarNumber: 3
  - chestID: Ciencia
    chestImage: {fileID: -244741445, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Tarvitset viisi todisteiden palasta tullaksesi todella viisaaksi.
      Todisteet ovat asioita, jotka voi n\xE4hd\xE4, mitata tai todistaa, eik\xE4
      niist\xE4 voi kiistell\xE4. Esimerkiksi ilmastonmuutoksesta on todisteita,
      kuten satelliittikuvia ja valokuvia sulavista j\xE4\xE4tik\xF6ist\xE4. Jos
      haluat ymm\xE4rt\xE4\xE4 jotakin ilmi\xF6t\xE4, ensin pit\xE4\xE4 ker\xE4t\xE4
      faktoja ja sitten ajatella tarkasti, mit\xE4 ne tarkoittavat. "
    altarNumber: 5
  - chestID: Humanidades
    chestImage: {fileID: 1253979381, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Viisauden saavuttamiseen tarvitset yhden osan hy\xF6dyllisyytt\xE4
      ja kaksi osaa luotettavia l\xE4hteit\xE4. Hy\xF6dyllisyys tarkoittaa, ett\xE4
      tieto auttaa sinua jossain asiassa. Esimerkiksi jos tied\xE4t, mit\xE4 voi
      tapahtua, kun jaat jotain somessa, se auttaa suojautumaan ik\xE4vilt\xE4 kokemuksilta.
      Luotettavat l\xE4hteet tarkoittavat, ett\xE4 tieto tulee alkuper\xE4isest\xE4
      ja rehellisest\xE4 l\xE4hteest\xE4. Jos haluat ymm\xE4rt\xE4\xE4, milt\xE4
      toisesta tuntuu, kysy h\xE4nelt\xE4 suoraan \u2013 silloin saat oikean vastauksen."
    altarNumber: 1
  fusionErrorText: Varoitus, jokin ei toimi...
  fusionSuccessText: "Jokainen ihminen on t\xE4rke\xE4 ja voi vaikuttaa asioihin,
    jos h\xE4n seuraa viisauden polkua... Sen vuoksi arvoitus j\xE4\xE4 puutteelliseksi,
    sill\xE4 jokaisen on teht\xE4v\xE4 osuutensa: p\xE4\xE4tett\xE4v\xE4, miten el\xE4\xE4
    ja mit\xE4 varten el\xE4\xE4."
