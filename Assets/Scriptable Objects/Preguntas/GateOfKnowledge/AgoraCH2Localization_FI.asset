MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9becf7d9ed3e4454db5aa56b7345d9f1, type: 3}
  m_Name: AgoraCH2Localization_FI
  m_EditorClassIdentifier: 
  chests:
  - chestID: Arte
    chestImage: {fileID: -566849752, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Todellisen viisauden saavuttamiseksi sinun on muistettava, ett\xE4
      on aina useampi kuin yksi n\xE4k\xF6kulma siihen, mik\xE4 on totuus\u2026 Muutamat
      el\xE4m\xE4ntotuudet ovat vain tapoja, ja perustuvat tunteisiin tai intuitioon.
      Taide puhuu kaikista n\xE4ist\xE4 totuuden tyypeist\xE4. Esimerkiksi, kun Gata
      Cattana, espanjalainen runoilija ja  r\xE4pp\xE4ri, sanoo ett\xE4 \u201DRikkaat
      ja k\xF6yh\xE4t eiv\xE4t rakasta yht\xE4 lailla\u201D, h\xE4n ei esit\xE4 yksikertaista
      tosiasiaa vaan mielentilan ja julkilausuman"
    altarNumber: 2
  - chestID: Historia
    chestImage: {fileID: 394024147, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Todellisen viisauden saavuttamiseksi tarvitaan nelj\xE4 yht\xE4pit\xE4vyyden
      osaa. Yht\xE4pit\xE4vyydell\xE4 tarkoitetaan sit\xE4, vastaako tieto todellisuutta.
      Tarkista aina todellisuus varmistaaksesi, onko tieto tosi. Jos esimerkiksi
      olet terveystietoinen ja p\xE4\xE4t\xE4t ostaa uudenmerkkisi\xE4 aamiaismuroja,
      joiden v\xE4itet\xE4\xE4n koostuvan kokonaisuudessaan luomulaatuisista ainesosista,
      voit tarkistaa kyseisen v\xE4itteen. Tutustu merkkiin ja tarkista luomusertifioinnin
      aitous varmistaaksesi, ett\xE4 tiedot vastaavat todellisuutta. T\xE4m\xE4 auttaa
      sinua kehitt\xE4m\xE4\xE4n kriittist\xE4 ajattelua ja kyky\xE4si ker\xE4t\xE4,
      lajitella ja suodattaa tietoja."
    altarNumber: 4
  - chestID: Mates
    chestImage: {fileID: -950423340, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "odellisen viisauden saavuttamiseksi tarvitaan kolme johdonmukaisuuden
      osaa. Johdonmukaisuudella tarkoitetaan sit\xE4, onko tieto yhdenmukainen muiden
      totuuksien kanssa. Arvioi esimerkiksi tulevaisuuden urapolusta p\xE4\xE4tt\xE4misen
      aikana huolellisesti henkil\xF6kohtaiset kiinnostuksen kohteesi, arvosi ja
      pitk\xE4n t\xE4ht\xE4imen tavoitteesi, joiden tied\xE4t olevan totta, ja huomioi
      ne johdonmukaisesti p\xE4\xE4t\xF6ksi\xE4 tehdess\xE4si. N\xE4m\xE4 toimet
      johtavat kriittisen ajattelun kehitt\xE4miseen el\xE4m\xE4nvalinnoissasi."
    altarNumber: 3
  - chestID: Ciencia
    chestImage: {fileID: -244741445, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Tarvitset todellisen viisauden saavuttamiseksi 5 todistetta.
      Todisteet ovat n\xE4ytt\xF6j\xE4 tai objektiivisia tosiseikkoja, jotka eiv\xE4t
      ole kyseenalaisia, koska me kaikki voimme havaita ne. Ilmaston l\xE4mpeneminen
      esimerkiksi on ilmi\xF6, jolle on useita todisteita, ja yksi havaittava vaikutus
      on ajan mittaan otetuissa satelliittikuvissa ja valokuvissa n\xE4kyv\xE4 j\xE4\xE4tik\xF6iden
      sulaminen. Tilanteen ymm\xE4rt\xE4miseksi ja saadaksesi selville, onko ilmi\xF6
      totta, sinun ker\xE4tt\xE4v\xE4 tosiasioita ja sitten tarkasteltava asiaa kriittisesti."
    altarNumber: 5
  - chestID: Humanidades
    chestImage: {fileID: 1253979381, guid: cd191b1f2452b4a49936754476ef1e03, type: 3}
    textChest: "Hienoa! T\xE4m\xE4 on totuuden palanen rakennuksesta"
    textClueAgora: "Todellisen viisauden saavuttamiseksi tarvitset 1 osan k\xE4ytt\xF6kelpoisuutta
      & 2 osaa alkuper\xE4isi\xE4/luotettavia l\xE4hteit\xE4. K\xE4ytt\xF6kelpoisuus
      viittaa tiedon laatuun suhteessa tavoitteeseen. Esimerkiksi tietyn sis\xE4ll\xF6n
      jakamiseen sosiaalisessa mediassa liittyvien mahdollisten seurausten tiedostaminen
      on hy\xF6dyllist\xE4, jotta ihminen voi suojata itse\xE4\xE4n haitallisilta
      kokemuksilta. Alkuper\xE4isen l\xE4hteen selvitt\xE4minen on tapa l\xF6yt\xE4\xE4
      totuus subjektiivisesta kokemuksesta. Jos esimerkiksi haluat tiet\xE4\xE4,
      milt\xE4 jostakin ihmisest\xE4 tuntuu, on parempi kysy\xE4 h\xE4nelt\xE4 suoraan
      sen sijaan, ett\xE4 arvailisit tai kyselisit sit\xE4 toisilta."
    altarNumber: 1
  fusionErrorText: Varoitus, jokin ei toimi...
  fusionSuccessText: "Jokainen ihminen on t\xE4rke\xE4 ja voi vaikuttaa asioihin,
    jos h\xE4n seuraa viisauden polkua... Sen vuoksi arvoitus j\xE4\xE4 puutteelliseksi,
    sill\xE4 jokaisen on teht\xE4v\xE4 osuutensa: p\xE4\xE4tett\xE4v\xE4, miten el\xE4\xE4
    ja mit\xE4 varten el\xE4\xE4."
