  m_Script: {fileID: 11500000, guid: a199021ed40311346813ff812dbc56fb, type: 3}
  m_Name: EmotionsFrustration_EN
  m_EditorClassIdentifier: 
  introText: Hm? What's hapenning here???
  nextButtonText: Next
  meditationDialogue1: "You look frustrated\u2026"
  meditationDialogue2: "It is ok to be frustrated\u2026 That means this is important
    to you, that you want to make it better\u2026"
  meditationDialogue3: "When feelling frustration, I use to meditate. I\u2019ll show
    you\u2026 "
  meditationInstruction1: close your eyes for a moment
  meditationInstruction2: take a few seconds to breath
  meditationInstruction3: "open our eyes\u2026 sometimes it is better to take a moment
    to feel the emotion, breath slowly, be attentive, without any judgment: everything
    you feel is ok\u2026 there is always a way\u2026 something you can do\u2026 you
    just have to open your eyes\u2026"
  meditationFinalText1: "It is important to know how to overcome your frustration\u2026.
    to accept defeat\u2026 because we all lose at some point\u2026"
  meditationFinalText2: "Show compassion and be kind to yourself and others\u2026
    Compassion means suspending judgment temporarily in order to detach yourself
    and appreciate other perspectives on your situation\u2026 or even situations
    of others when they are different from your own\u2026"
  meditationFinalText3: "This allows you to determine your values and decide where
    you want to go, what you want to do\u2026 and find your path in the labyrinth
    of life\u2026"
  meditationNextButtonText: next
