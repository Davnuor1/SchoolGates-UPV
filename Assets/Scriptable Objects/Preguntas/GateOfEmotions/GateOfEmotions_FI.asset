  m_Script: {fileID: 11500000, guid: 91ed8fbac4f95a646a385ee421129d7d, type: 3}
  m_Name: GateOfEmotions_FI
  m_EditorClassIdentifier: 
  introductionText: "Olet aikeissa siirty\xE4 eri tietoisuuden tilaan..."
  selectTwoEmotionsText: "Mit\xE4 tunteita tunnet useimmin?"
  anger: Suuttumus
  fear: Pelko
  joy: Ilo
  sadness: Surullisuus
  question1: "Tuntuuko sinusta miellytt\xE4v\xE4lt\xE4 vai ep\xE4miellytt\xE4v\xE4lt\xE4?"
  question2: Onko energiatasosi korkealla vai matalalla?
  question3: "Miksi kutsuisit t\xE4t\xE4 tunnetta?"
  pleasant: "Miellytt\xE4v\xE4"
  unpleasant: "Ep\xE4miellytt\xE4v\xE4"
  highEnergy: Energinen
  lowEnergy: "V\xE4h\xE4inen energia"
  feedbackIncorrect: "T\xE4m\xE4 ei vaikuta silt\xE4 tunteelta, jota tunnet juuri
    nyt. Yrit\xE4 uudelleen.."
  feedbackCorrecto01: "T\xE4m\xE4 n\xE4ytt\xE4\xE4 oikealta... On hyv\xE4 tuntea"
  feedbackCorrecto02: "Palaa nyt kaupunkiin ja l\xF6yd\xE4 tapa jatkaa matkaasi labyrintiss\xE4..."
  feedbackAnger: "Viha syntyy, kun joku satuttaa sinua tai kohtelee sinua ep\xE4reilusti.
    Se antaa sinulle voimaa, jotta voit puolustaa itse\xE4si ja sit\xE4, mik\xE4
    on sinulle t\xE4rke\xE4\xE4."
  feedbackFear: "Pelko syntyy, kun jokin t\xE4rke\xE4 asia tuntuu olevan vaarassa.
    Se pys\xE4ytt\xE4\xE4 meid\xE4t hetkeksi, jotta voimme mietti\xE4 tilannetta
    kunnolla. Se saa meid\xE4t haluamaan paeta, jotta voimme suojella itse\xE4mme."
  feedbackJoy: "Ilo tulee, kun onnistumme jossain t\xE4rke\xE4ss\xE4 asiassa. Se
    tuntuu kuin palkinnolta: se antaa meille energiaa ja saa meid\xE4t haluamaan
    jatkaa tekemist\xE4, josta pid\xE4mme."
  feedbackSadness: "Suru tulee, kun menet\xE4mme jotain tai jonkun, jota rakastamme.
    Se vie meilt\xE4 voimia, jotta pys\xE4htyisimme hetkeksi \u2013 itkem\xE4\xE4n,
    miettim\xE4\xE4n\u2026 ja pikkuhiljaa toipumaan."
  questionPart2: "Mit\xE4 tunnetta h\xE4n kokee?"
  feedbackIncorrectPart2: "T\xE4m\xE4 ei vaikuta silt\xE4 tunteelta, jota h\xE4n
    kokee juuri nyt. Yrit\xE4 uudelleen..."
  respuestaJugador1: "Luulen, ett\xE4 olet"
  respuestaNPC1: Mutta en halua olla
  botonesRespuestaJugador2:
  - "Tied\xE4n, ett\xE4 se on vaikeaa, mutta on ihan ok tuntea n\xE4in..."
  - "\xC4l\xE4 huoli \u2013 t\xE4m\xE4 tunne menee ohi jossain vaiheessa..."
  - "Minullekin on k\xE4ynyt niin\u2026 Etsit\xE4\xE4n jotain, mik\xE4 saa olon tuntumaan
    paremmalta..."
  feedbackAnger_Part2: "Hyv\xE4! Viha syntyy, kun joku satuttaa sinua tai kohtelee
    sinua ep\xE4reilusti. Se antaa sinulle voimaa, jotta voit puolustaa itse\xE4si
    ja sit\xE4, mik\xE4 on sinulle t\xE4rke\xE4\xE4. Nyt palaa kaupunkiin ja auta
    h\xE4nt\xE4 tunteiden polulla.."
  feedbackFear_Part2: "Hyv\xE4! Pelko syntyy, kun jokin t\xE4rke\xE4 asia tuntuu
    olevan vaarassa. Se pys\xE4ytt\xE4\xE4 meid\xE4t hetkeksi, jotta voimme mietti\xE4
    tilannetta kunnolla. Se saa meid\xE4t haluamaan paeta, jotta voimme suojella
    itse\xE4mme. Nyt palaa kaupunkiin ja auta h\xE4nt\xE4 tunteiden polulla.."
  feedbackJoy_Part2: "Hyv\xE4! Ilo tulee, kun onnistumme jossain t\xE4rke\xE4ss\xE4
    asiassa. Se tuntuu kuin palkinnolta: se antaa meille energiaa ja saa meid\xE4t
    haluamaan jatkaa tekemist\xE4, josta pid\xE4mme. Nyt palaa kaupunkiin ja auta
    h\xE4nt\xE4 tunteiden polulla.."
  feedbackSadness_Part2: "Hyv\xE4! Suru tulee, kun menet\xE4mme jotain tai jonkun,
    jota rakastamme. Se vie meilt\xE4 voimia, jotta pys\xE4htyisimme hetkeksi \u2013
    itkem\xE4\xE4n, miettim\xE4\xE4n\u2026 ja pikkuhiljaa toipumaan. Nyt palaa kaupunkiin
    ja auta h\xE4nt\xE4 tunteiden polulla.."
