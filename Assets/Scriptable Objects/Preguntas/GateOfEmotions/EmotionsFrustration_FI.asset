  m_Script: {fileID: 11500000, guid: a199021ed40311346813ff812dbc56fb, type: 3}
  m_Name: EmotionsFrustration_FI
  m_EditorClassIdentifier: 
  introText: "Hm? Mit\xE4 t\xE4\xE4ll\xE4 tapahtuu???"
  nextButtonText: Seuraava
  meditationDialogue1: "N\xE4yt\xE4t turhautuneelta..."
  meditationDialogue2: "On ihan ok olla turhautunut\u2026 Se tarkoittaa, ett\xE4
    t\xE4m\xE4 on sinulle t\xE4rke\xE4\xE4 ja haluat parantaa tilanteen."
  meditationDialogue3: "Kun min\xE4 olen turhautunut, meditoin. N\xE4yt\xE4n sinulle..."
  meditationInstruction1: "Sulje silm\xE4si hetkeksi."
  meditationInstruction2: "Hengit\xE4 muutaman sekunnin ajan rauhallisesti"
  meditationInstruction3: "Avaa silm\xE4si\u2026 joskus on parempi pys\xE4hty\xE4
    tuntemaan tunne, hengitt\xE4\xE4 hitaasti, olla tarkkaavainen, tuomitsematta
    mit\xE4\xE4n: kaikki tunteesi ovat oikeutettuja\u2026 on aina olemassa ratkaisu\u2026
    jotakin, mit\xE4 voit tehd\xE4\u2026 sinun on vain avattava silm\xE4si\u2026"
  meditationFinalText1: "On ihan normaalia tuntea turhautumista tai ep\xE4onnistua
    joskus. T\xE4rkeint\xE4 on, miten suhtaudut siihen."
  meditationFinalText2: "Ole lempe\xE4 itsellesi ja muille. My\xF6t\xE4tunto tarkoittaa,
    ettei arvostele \u2013 vaan katsoo asioita toisin silmin."
  meditationFinalText3: "Silloin voit n\xE4hd\xE4, mik\xE4 on sinulle t\xE4rke\xE4\xE4,
    ja valita, mihin suuntaan haluat kulkea el\xE4m\xE4n sokkelossa."
  meditationNextButtonText: Seuraava
  gardenText1: "Tervetuloa puutarhaan \u2013 kaupungin syd\xE4meen!"
  gardenText2: "Olet oppinut tunneosaamisen perusteet. Nyt edess\xE4si on 3 uutta
    haastetta, joissa k\xE4sitell\xE4\xE4n monimutkaisempia tunteita"
  gardenNextButtonText: Seuraava
