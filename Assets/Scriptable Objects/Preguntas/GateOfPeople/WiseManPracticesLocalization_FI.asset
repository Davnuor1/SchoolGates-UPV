%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f125b745d539af443b514f6298b234dc, type: 3}
  m_Name: WiseManPracticesLocalization_FI
  m_EditorClassIdentifier: 
  vignettes:
  - backgroundImage: {fileID: 1251884205, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "T\xE4m\xE4 on hyvin vaarallinen paikka..."
    placement: 0
  - backgroundImage: {fileID: -1636791454, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Kun tapaamme jonkun ihmisen ensimm\xE4ist\xE4 kertaa, selvit\xE4mme ensin
      kuka ja millainen kyseinen henkil\xF6 on, onko meill\xE4 jotakin yhteist\xE4,
      onko meill\xE4 samoja harrastuksia tai arvoja ... N\xE4m\xE4 ovat ihmissuhteen
      perustat ja rakennuspalikat. Sen j\xE4lkeen ihmiset alkavat kertoa lis\xE4\xE4
      itsest\xE4\xE4n ja testata suhteensa rajoja."
    placement: 1
  - backgroundImage: {fileID: 1595807204, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Kaikista ihmisist\xE4 l\xF6ytyy aina joitakin yhteisi\xE4 asioita, mutta
      niiden l\xF6yt\xE4miseksi on tutustuttava ihmiseen paremmin. Mit\xE4 enemm\xE4n
      jaatte asioita, sit\xE4 todenn\xE4k\xF6isemmin teist\xE4 tulee yst\xE4vi\xE4.
      Ja jos teist\xE4 tulee yst\xE4vi\xE4, olet luonut t\xE4h\xE4n ihmiseen siteen."
    placement: 1
  - backgroundImage: {fileID: -1554177124, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Jos kaikki menee hyvin, side tulee kest\xE4m\xE4\xE4n koko el\xE4m\xE4n,
      ja se on hienoa! Mutta aina voi tulla riitoja tai erimielisyyksi\xE4, jotka
      on ratkaistava."
    placement: 1
  - backgroundImage: {fileID: 1245444621, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Ihmisten tapaaminen ja siteen luominen heihin on hienoa\u2026 Mutta ihmissuhteet
      voivat muuttua ja voi tulla ongelmia. Silloin on t\xE4rke\xE4\xE4 tiet\xE4\xE4,
      miten niist\xE4 selvit\xE4\xE4n ja voidaan luoda menestyvi\xE4 ja kest\xE4vi\xE4
      ihmissuhteita."
    placement: 2
  - backgroundImage: {fileID: 686330089, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Ihmissuhteet voivat my\xF6s rapistua. Joskus ihmiset muuttuvat tai el\xE4m\xE4
      erottaa polkumme... Ja silloin yst\xE4v\xE4t tai pariskunnat voivat tuntea
      olonsa aina vain et\xE4isemm\xE4ksi, aina vai kaukaisemmaksi... Kunnes ihmissuhde
      p\xE4\xE4ttyy. Mutta vaikka hyv\xE4steleminen voi sattua, joskus on parempi
      antaa toisen ihmisen menn\xE4\u2026"
    placement: 2
  - backgroundImage: {fileID: 1657986904, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Mutta ennen muinoin se oli rauhallinen\u2026"
    placement: 0
  - backgroundImage: {fileID: 533894941, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "N\xE4hdyt kauhistuttavat olennot"
    placement: 0
  - backgroundImage: {fileID: -243137760, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "olivat kerran ihmisi\xE4, kuten me."
    placement: 0
  - backgroundImage: {fileID: -713351420, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Mutta sitten he alkoivat olla ep\xE4reiluja toisille, heille uskoteltiin,
      ett\xE4 he voivat saada kaiken, mit\xE4 halusivat."
    placement: 0
  - backgroundImage: {fileID: 5121602, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "He menettiv\xE4t kaiken ihmisyytens\xE4"
    placement: 0
  - backgroundImage: {fileID: -736844791, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "ja nyt heid\xE4n sielunsa on kadoksissa jossain..."
    placement: 0
  - backgroundImage: {fileID: -1772837806, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Jotta suosta tulisi j\xE4lleen turvallinen, kaikkia on kohdeltava reilusti,
      jokaisella on oikeus l\xF6yt\xE4\xE4 turvallinen paikka... Opetamme sinulle,
      mit\xE4 sinun pit\xE4\xE4 tiet\xE4\xE4... heid\xE4n pelastamisekseen\u2026
      taistellaksesi ep\xE4oikeuksia vastaan lopullisesti\u2026 Tuo n\xE4m\xE4 sieluparat
      t\xE4nne meid\xE4n luoksemme\u2026"
    placement: 0
  - backgroundImage: {fileID: 1657986904, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Jotta suosta tulisi j\xE4lleen turvallinen, kaikkia on kohdeltava reilusti,
      jokaisella on oikeus l\xF6yt\xE4\xE4 turvallinen paikka... Opetamme sinulle,
      mit\xE4 sinun pit\xE4\xE4 tiet\xE4\xE4... heid\xE4n pelastamisekseen\u2026
      taistellaksesi ep\xE4oikeuksia vastaan lopullisesti\u2026 Tuo n\xE4m\xE4 sieluparat
      t\xE4nne meid\xE4n luoksemme\u2026"
    placement: 5
  conflicts:
  - dialogues:
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Saanko esitell\xE4 sinut Evelle, h\xE4n on todella hyv\xE4 jalkapalloilija\u2026"
      requiresResponse: 0
      responseOptions: []
    - characterName: Eve
      portrait: {fileID: 21300000, guid: 04816276ad4c8b64d80af5a19987b4b4, type: 3}
      text: "Pid\xE4tk\xF6 jalkapallosta?"
      requiresResponse: 1
      responseOptions:
      - responseText: En
        responseFeedback: "Eve on nyt v\xE4h\xE4n ymm\xE4ll\xE4\xE4n, olet ollut
          aito, mutta et ehk\xE4 kovin kunnioittava tai vastuuntuntoinen\u2026 Luulen,
          ett\xE4 Evest\xE4 ei en\xE4\xE4 tunnu mukavalta jutella kanssasi \u2026"
      - responseText: "Eve on nyt v\xE4h\xE4n ymm\xE4ll\xE4\xE4n, olet ollut aito,
          mutta et ehk\xE4 kovin kunnioittava tai vastuuntuntoinen\u2026 Luulen,
          ett\xE4 Evest\xE4 ei en\xE4\xE4 tunnu mukavalta jutella kanssasi \u2026"
        responseFeedback: "Evesta tuntuu nyt hyv\xE4lt\xE4, koska h\xE4n huomaa kiinnostuksesi
          ja h\xE4n on valmis my\xF6s tutustumaan sinuun. Olet ollut aito, vastuuntuntoinen,
          vuorovaikutteinen ja kunnioittava. Hienoa!"
      - responseText: "Kyll\xE4, pid\xE4n siit\xE4 paljon!"
        responseFeedback: "Evesta tuntuu nyt hyv\xE4lt\xE4, koska h\xE4n huomaa kiinnostuksesi
          ja h\xE4n on valmis my\xF6s tutustumaan sinuun. Olet ollut aito, vastuuntuntoinen,
          vuorovaikutteinen ja kunnioittava. Hienoa!"
    - characterName: Eve
      portrait: {fileID: 21300000, guid: 04816276ad4c8b64d80af5a19987b4b4, type: 3}
      text: "Ehk\xE4 voisimme perustaa naisten jalkapallokerhon"
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Kuvittele, ett\xE4 sin\xE4, Anna ja yst\xE4v\xE4si olette suunnitelleet
        jo kauan naisten jalkapallokerhon avajaisia, mutta aivan viime minuutilla
        siit\xE4 ei tulekaan mit\xE4\xE4n ... Kuka mielest\xE4si kommunikoi n\xE4iss\xE4
        esimerkeiss\xE4 tehokkaammin?"
      requiresResponse: 1
      responseOptions:
      - responseText: "Yksi heist\xE4 kritisoi toisten mielipidett\xE4/asennetta/k\xE4yt\xF6st\xE4."
        responseFeedback: "H\xE4n v\xE4h\xE4n aggressiivinen, eik\xF6 olekin? N\xE4in
          k\xE4y, kun joku ilmaisee ajatuksiaan ja tunteitaan toisista v\xE4litt\xE4m\xE4tt\xE4.
          Aggressiivinen kommunikaatio on m\xE4\xE4r\xE4ilev\xE4\xE4 ja kontrolloivaa.
          Siin\xE4 keskeytet\xE4\xE4n usein toiset, tunkeudutaan henkil\xF6kohtaiseen
          tilaan ja v\xE4h\xE4tell\xE4\xE4n toisia oman viestin saamiseksi perille.
          T\xE4m\xE4 johtaa konfliktiin ja mielipahaan."
      - responseText: "Yksi heist\xE4 on ollut alusta alkaen tyytym\xE4t\xF6n avajaisia
          varten suunnitelluista aktiviteeteista mutta ei ole sanonut mit\xE4\xE4n,
          koska h\xE4n on pel\xE4nnyt vaikuttavansa silloin \u201Dilonpilaajalta"
        responseFeedback: "H\xE4n on v\xE4h\xE4n passiivinen tai alistunut, eik\xF6
          olekin? N\xE4in k\xE4y, kun joku v\xE4ltt\xE4\xE4 ilmaisemasta ajatuksiaan
          tai tunteitaan, usein konfliktin pelosta"
      - responseText: "Yksi heist\xE4 sanoo, ett\xE4 avajaiset on siirrett\xE4v\xE4
          toiselle p\xE4iv\xE4lle, ja selitt\xE4\xE4 sen taustalla olevat syyt"
        responseFeedback: "Kommunikaation m\xE4\xE4r\xE4tietoiselle tyylille ovat
          ominaisia selke\xE4t, suorat viestit. Se mahdollistaa ajatusten ja tarpeiden
          ilmaisemisen kunnioittavalla tavalla."
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Kiitos mielipiteest\xE4si!"
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 1
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Kerropas minulle\u2026 Onko sinulla koskaan ollut t\xE4llaista yst\xE4v\xE4\xE4?"
      requiresResponse: 1
      responseOptions:
      - responseText: "Kyll\xE4, minulla on (tai oli) yst\xE4v\xE4, joka arvostelee
          aina toisten yst\xE4vien pukeutumista, kun he menev\xE4t ulos (\u201Dn\xE4yt\xE4t
          niin vanhanaikaiselta\") tai arvostelee heid\xE4n pelitaitojaan\u2026 mutta
          h\xE4n ei halua selitt\xE4\xE4, miksi, eik\xE4 ole valmis keskustelemaan"
        responseFeedback: 
      - responseText: 
        responseFeedback: 
      - responseText: "Kyll\xE4, minulla on yst\xE4v\xE4, joka ei koskaan sano ei.
          Yst\xE4v\xE4, joka ei koskaan valita, vaikka ei ole tyytyv\xE4inen tilanteeseen\u2026"
        responseFeedback: 
    requiresAllFeedback: 0
    isBranchingConflict: 1
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Kuuntele nyt tarkasti\u2026 etsi oma sis\xE4inen hiljaisuutesi, jotta
        voit menn\xE4 sanoja pidemm\xE4lle\u2026 Mit\xE4 mielest\xE4si todella tapahtuu?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Joku, joka aina arvostelee tekemi\xE4si p\xE4\xE4t\xF6ksi\xE4\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: "Ehk\xE4 h\xE4n pelk\xE4\xE4 jotakin\u2026"
        responseFeedback: "Oikein hyv\xE4, kyll\xE4... Emme voi olla siit\xE4 varmoja,
          mutta niin se saattaa olla\u2026 Ollaksesi hyv\xE4 kuuntelija sinun on
          kiinnitett\xE4v\xE4 sanojen lis\xE4ksi huomiota sanojen perimm\xE4iseen
          merkitykseen, yritett\xE4v\xE4 ymm\xE4rt\xE4\xE4, mik\xE4 kyseiselle on
          ihmiselle todella t\xE4rke\xE4\xE4."
      - responseText: "Ehk\xE4 h\xE4n ei vain pid\xE4 meist\xE4..."
        responseFeedback: "Oikein hyv\xE4, kyll\xE4... Emme voi olla siit\xE4 varmoja,
          mutta niin se saattaa olla\u2026 Ollaksesi hyv\xE4 kuuntelija sinun on
          kiinnitett\xE4v\xE4 sanojen lis\xE4ksi huomiota sanojen perimm\xE4iseen
          merkitykseen, yritett\xE4v\xE4 ymm\xE4rt\xE4\xE4, mik\xE4 kyseiselle on
          ihmiselle todella t\xE4rke\xE4\xE4."
      - responseText: "Ehk\xE4 h\xE4neen on sattunut aikaisemmin ja h\xE4n on viel\xE4
          vihainen"
        responseFeedback: "Oikein hyv\xE4, kyll\xE4... Emme voi olla siit\xE4 varmoja,
          mutta niin se saattaa olla\u2026 Ollaksesi hyv\xE4 kuuntelija sinun on
          kiinnitett\xE4v\xE4 sanojen lis\xE4ksi huomiota sanojen perimm\xE4iseen
          merkitykseen, yritett\xE4v\xE4 ymm\xE4rt\xE4\xE4, mik\xE4 kyseiselle on
          ihmiselle todella t\xE4rke\xE4\xE4."
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Miten voit vastata h\xE4nelle?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Sille, joka aina arvostelee tekemi\xE4si ratkaisuja\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: "Minusta sinun pit\xE4isi olla ihmisille v\xE4hemm\xE4n karski,
          se ei ole kivaa!"
        responseFeedback: "Nojaa, viestisi on selke\xE4 mutta ei ehk\xE4 kovin my\xF6t\xE4tuntoinen
          t\xE4t\xE4 ihmist\xE4 kohtaa."
      - responseText: "Okei, t\xE4st\xE4 l\xE4htien arvostelen kaikkea, mit\xE4 sin\xE4
          sanot!"
        responseFeedback: "Ehk\xE4 toimit liian impulsiivisesti, k\xE4yt\xF6ksesi
          on samanlaista kuin arvostelemasi k\xE4yt\xF6s!"
      - responseText: "Minusta tuntuu, ett\xE4 jokin suututtaa sinua. Haluatko jutella
          siit\xE4?"
        responseFeedback: "Hienoa, olet selke\xE4 mutta my\xF6t\xE4tuntoinen. Ollaksesi
          kunnioittava mieti aina, miten sin\xE4 haluaisit sinulle kerrottavan\u2026"
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Olet juuri harjoitellut hyv\xE4n kommunikaation aakkosia. Riippumatta
        siit\xE4, miss\xE4 ihmissuhteen vaiheessa olet, on t\xE4rke\xE4\xE4 kommunikoida
        oikealla tavalla siten, ett\xE4 kaikilla on turvallinen olo..."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Kuuntele nyt tarkasti\u2026 etsi oma sis\xE4inen hiljaisuutesi, jotta
        voit menn\xE4 sanoja pidemm\xE4lle\u2026 Mit\xE4 mielest\xE4si todella tapahtuu?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Ihminen, joka ei ole tyytyv\xE4inen, mutta ei sano mit\xE4\xE4n..."
      requiresResponse: 1
      responseOptions:
      - responseText: "Pelk\xE4\xE4 ehk\xE4, ett\xE4 toiset yst\xE4v\xE4t hylk\xE4\xE4v\xE4t
          h\xE4net"
        responseFeedback: "Oikein hyv\xE4, kyll\xE4... Emme voi olla siit\xE4 varmoja,
          mutta niin se saattaa olla\u2026 Ollaksesi hyv\xE4 kuuntelija sinun on
          kiinnitett\xE4v\xE4 sanojen lis\xE4ksi huomiota sanojen perimm\xE4iseen
          merkitykseen, yritett\xE4v\xE4 ymm\xE4rt\xE4\xE4, mik\xE4 kyseiselle on
          ihmiselle todella t\xE4rke\xE4\xE4."
      - responseText: "Ehk\xE4 h\xE4nelt\xE4 on kysytt\xE4v\xE4, jotta h\xE4n kertoisi
          mielipiteens\xE4"
        responseFeedback: "Oikein hyv\xE4, kyll\xE4... Emme voi olla siit\xE4 varmoja,
          mutta niin se saattaa olla\u2026 Ollaksesi hyv\xE4 kuuntelija sinun on
          kiinnitett\xE4v\xE4 sanojen lis\xE4ksi huomiota sanojen perimm\xE4iseen
          merkitykseen, yritett\xE4v\xE4 ymm\xE4rt\xE4\xE4, mik\xE4 kyseiselle on
          ihmiselle todella t\xE4rke\xE4\xE4."
      - responseText: "Ehk\xE4 h\xE4n ei usko, ett\xE4 h\xE4nen yst\xE4v\xE4ns\xE4
          kuulisivat h\xE4nen ajatuksiaan mielell\xE4\xE4n"
        responseFeedback: "Oikein hyv\xE4, kyll\xE4... Emme voi olla siit\xE4 varmoja,
          mutta niin se saattaa olla\u2026 Ollaksesi hyv\xE4 kuuntelija sinun on
          kiinnitett\xE4v\xE4 sanojen lis\xE4ksi huomiota sanojen perimm\xE4iseen
          merkitykseen, yritett\xE4v\xE4 ymm\xE4rt\xE4\xE4, mik\xE4 kyseiselle on
          ihmiselle todella t\xE4rke\xE4\xE4."
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Miten voit vastata h\xE4nelle?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Sille, joka ei ole tyytyv\xE4inen suunniteltuun aktiviteettiin mutta
        ei sano mit\xE4\xE4n..."
      requiresResponse: 1
      responseOptions:
      - responseText: "Et koskaan sano, mit\xE4 sinulla on mieless\xE4si, mit\xE4
          todella ajattelet. On hyvin vaikeaa olla yst\xE4v\xE4si!"
        responseFeedback: "Nojaa, viestisi on selke\xE4 mutta ei ehk\xE4 kovin my\xF6t\xE4tuntoinen
          t\xE4t\xE4 ihmist\xE4 kohtaa."
      - responseText: "Olet meid\xE4n hyv\xE4 yst\xE4v\xE4mme, eth\xE4n koskaan luule,
          ett\xE4 me emme halua kuulla mielipiteit\xE4si. Mielipiteesi ovat t\xE4rkeit\xE4
          ja haluamme tiet\xE4\xE4 ne"
        responseFeedback: "Hienoa, olet selke\xE4 mutta silti my\xF6t\xE4tuntoinen.
          Ollaksesi kunnioittava mieti aina, miten sin\xE4 haluaisit sinulle kerrottavan\u2026"
      - responseText: "Joskus ajattelen, ett\xE4 et ole mist\xE4\xE4n mit\xE4\xE4n
          mielt\xE4. Onko sinulla ikin\xE4 mielipidett\xE4 mist\xE4\xE4n?"
        responseFeedback: "Nojaa, viestisi on selke\xE4 mutta ei ehk\xE4 kovin my\xF6t\xE4tuntoinen
          t\xE4t\xE4 ihmist\xE4 kohtaa."
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Olet juuri harjoitellut hyv\xE4n kommunikaation aakkosia. Riippumatta
        siit\xE4, miss\xE4 ihmissuhteen vaiheessa olet, on t\xE4rke\xE4\xE4 kommunikoida
        oikealla tavalla siten, ett\xE4 kaikilla on turvallinen olo..."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  conflict1Concepts:
  - term: Kunnioittava
    description: "T\xE4m\xE4 tarkoittaa, ett\xE4 yrit\xE4t ymm\xE4rt\xE4\xE4 ja n\xE4ytt\xE4\xE4
      kiinnostusta toisten kokemuksiin ja n\xE4k\xF6kulmiin, vaikka olisit eri mielt\xE4."
  - term: Aito
    description: "T\xE4m\xE4 tarkoittaa, ett\xE4 olet autenttinen ja vilpit\xF6n
      etk\xE4 teeskentele. Ilmaiset todelliset uskomuksesi, vaikka ne olisivat toisille
      haastavia tai ep\xE4mukavia tai aiheuttaisivat heille pettymyksen."
  - term: Vastuuntuntoinen
    description: "T\xE4m\xE4 tarkoittaa sit\xE4, ett\xE4 olet vastuussa teoistasi
      ja tunteistasi. Et syyt\xE4 ongelmistasi muita."
  - term: Vuorovaikutteinen
    description: "T\xE4m\xE4 tarkoittaa impulsiivisten reaktioiden v\xE4ltt\xE4mist\xE4.
      My\xF6t\xE4tuntoinen ja ymm\xE4rt\xE4v\xE4 reagointi.\r\n"
  conflict3Concepts:
  - term: "HYV\xC4 KUUNTELIJA"
    description: " Aktiivinen kuuntelu tarkoittaa t\xE4yden huomion kohdistamista
      sinulle puhuvalle ihmiselle ilman arvostelua. Ollaksesi hyv\xE4 kuuntelija
      sinun on muodostettava sis\xE4inen hiljaisuus, joka mahdollistaa toisen henkil\xF6n
      viestin vastaanottamisen selke\xE4sti. Ole tarkkaavainen, kun toinen ihminen
      puhuu sinulle, mene sanoja pidemm\xE4lle ja tee parhaasi ymm\xE4rt\xE4\xE4ksesi
      merkityksen. Mik\xE4 on t\xE4rke\xE4\xE4 t\xE4lle ihmiselle?"
  - term: "SELKE\xC4"
    description: "Lyhyet viestit: Pid\xE4 viestisi mahdollisimman lyhyen\xE4, mutta
      kuitenkin t\xE4ydellisen\xE4. Hyv\xE4 viestij\xE4 yritt\xE4\xE4 saada viestins\xE4
      v\xE4litetty\xE4 mahdollisimman tehokkaasti ja yksityiskohtaisesti, mutta ilman
      tarpeettomia yksityiskohtia. Ollaksesi selke\xE4 mieti, mik\xE4 on todella
      t\xE4rke\xE4\xE4 siin\xE4, mit\xE4 haluat sanoa, ja sano se mahdollisimman
      ytimekk\xE4\xE4sti."
  - term: "MY\xD6T\xC4TUNTOINEN"
    description: "My\xF6t\xE4tunto: Empaattiselle kommunikaatiolle on tunnusomaista
      toisten ihmisten tunteiden ymm\xE4rt\xE4minen ja jakaminen. Ihmisl\xE4heinen
      kommunikaatio asettaa etusijalle ihmissuhteiden luomisen ja vaalimisen. Ollaksesi
      kunnioittava mieti, miten haluaisit ihmisille puhuttavan."
