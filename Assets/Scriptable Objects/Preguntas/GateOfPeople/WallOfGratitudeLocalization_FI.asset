MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05a61ef5f9b69e544ba75093eb10ed3d, type: 3}
  m_Name: WallOfGratitudeLocalization_FI
  m_EditorClassIdentifier: 
  upperTextMain: "Aina on jotakin, mist\xE4 olla kiitollinen... Mieti, mist\xE4 olet
    kiitollinen ja aseta kivi sein\xE4\xE4n..."
  upperTextStoneView: "Haluatko lis\xE4t\xE4 t\xE4m\xE4n kiven kiitollisuuden sein\xE4lle?"
  upperTextGratitudeWall: "T\xE4m\xE4 on sinun kiitollisuuden sein\xE4si."
  finishButton: Valmis
  addToWallButton: "Lis\xE4\xE4 sein\xE4lle"
  backButton: Takaisin
  nextButton: Seuraava
  previousButton: Edellinen
  gratitudeWallTitle: "Kiitollisuuden sein\xE4"
  stones:
  - title: "Yst\xE4v\xE4t ja ihmissuhteet "
    descriptions:
    - "\uF0B7Minulla on hyvi\xE4 ja luotettavia kavereita / paras kaveri\r"
    - "Kaverit ja l\xE4heiset ihmiset tukevat ja v\xE4litt\xE4v\xE4t minusta"
    - Minulla on joku, joka rakastaa minua ja on minun puolella
    - "Saan nauraa ja pit\xE4\xE4 hauskaa kavereiden kanssa\r"
  - title: Perhe
    descriptions:
    - "Minulla on perhe tai sisaruksia, jotka v\xE4litt\xE4v\xE4t minusta\r"
    - "Voin pyyt\xE4\xE4 apua ja saan sit\xE4, kun tarvitsen"
    - Minua kuunnellaan ja otetaan tosissaan
    - "Meill\xE4 on mukavia muistoja ja yhteisi\xE4 hetki\xE4\r"
  - title: Vapaus ja turvallisuus
    descriptions:
    - "Voin kertoa, mit\xE4 ajattelen ja tunnen"
    - "Saan apua, jos minua kohdellaan huonosti tai minut j\xE4tet\xE4\xE4n ulkopuolelle"
    - "El\xE4n rauhallisessa ja turvallisessa paikassa"
  - title: Perustarpeet
    descriptions:
    - "Minulla on ruokaa sy\xF6t\xE4v\xE4ksi"
    - "Minulla on koti, jossa on hyv\xE4 olla"
    - "Minulla on puhdasta vett\xE4 juotavaksi\r"
  - title: Koulutus
    descriptions:
    - "Saan k\xE4yd\xE4 koulua ja oppia uusia asioita"
    - Minulla on mukavia opettajia ja aikuisia, jotka auttavat
    - "Voin oppia ja tulla paremmaksi siin\xE4, mit\xE4 teen"
  - title: Aika
    descriptions:
    - "Minulla on mielek\xE4st\xE4 vapaa-aikaa"
    - "Minulla on hetki\xE4, jolloin voin olla ihan rauhassa"
    - "Voin mietti\xE4 omia ajatuksiani ja tunteitani"
  - title: "Henkil\xF6kohtaiset saavutukset"
    descriptions:
    - Voin haaveilla tulevaisuudestani
    - "Olen selvinnyt vaikeista tilanteista\r"
    - "Olen saanut jotain t\xE4rke\xE4\xE4 tehty\xE4 tai onnistunut jossain\r"
  - title: 'Terveys ja hyvinvointi '
    descriptions:
    - Olen terve ja voin hyvin
    - Saan hoitoa, jos sairastun
    - "Tunnen oloni tyytyv\xE4iseksi ja iloiseksi el\xE4m\xE4ss\xE4ni"
  - title: Luonto
    descriptions:
    - "Voin hengitt\xE4\xE4 raikasta ilmaa ja el\xE4\xE4 puhtaassa ymp\xE4rist\xF6ss\xE4"
    - "Voin k\xE4yd\xE4 ulkona ja nauttia luonnosta ja maisemista\r"
  - title: Teknologia
    descriptions:
    - "Voin etsi\xE4 tietoa netist\xE4"
    - "Minulla on puhelin, tabletti tai tietokone, jolla voin yhteydess\xE4 muihin"
