%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05a61ef5f9b69e544ba75093eb10ed3d, type: 3}
  m_Name: WallOfGratitudeLocalization_EN
  m_EditorClassIdentifier: 
  upperTextMain: "Here is always something to be grateful for... think about what
    you are grateful for and put the stone in the wall\u2026 You have to watch all
    10 stones to finish!"
  upperTextStoneView: Do you want to add this stone to the wall of gratitude?
  upperTextGratitudeWall: This is your Wall of Gratitude
  finishButton: Finish
  addToWallButton: Add To Wall
  backButton: Return
  nextButton: Next
  previousButton: Previous
  gratitudeWallTitle: Nose
  stones:
  - title: Friends and relationships
    descriptions:
    - Having loyal friends/Having a best friend
    - Being supported and loved by the people I care about
    - Having a partner who loves and supports me
    - Having a good time with my friends
  - title: Family
    descriptions:
    - Having a caring and supportive family/siblings
    - Feeling I can ask for help and being helped
    - Being listened to and acknowledged
    - Sharing happy memories and experiences
  - title: Freedom and safety
    descriptions:
    - Being able to express my feelings and thoughts
    - "Having support when you have been discriminated against or excluded\r"
    - Living in peace and security
  - title: Basic needs
    descriptions:
    - Having food to eat
    - Having a home that is safe
    - Having access to clean water
  - title: Education
    descriptions:
    - Being able to go to school and learn new things
    - Having good teachers and mentors
    - 'Being able to grow and develop my potential '
  - title: Time
    descriptions:
    - Being able to have free time
    - Having moments for myself
    - "Having opportunities for self-reflection\r"
  - title: Personal Achievements
    descriptions:
    - Being able to dream about my future
    - Having faced and overcome difficulties
    - Accomplishing my goals
  - title: Health & well-being
    descriptions:
    - Being in good mental and physical health
    - Having access to good healthcare
    - Feeling satisfied and fulfilled with my life
  - title: Nature
    descriptions:
    - Access to fresh air and clean environment
    - Enjoying beautiful landscape, being in nature
  - title: Technology
    descriptions:
    - Having a partner who loves and supports me
    - Having a good time with my friends
