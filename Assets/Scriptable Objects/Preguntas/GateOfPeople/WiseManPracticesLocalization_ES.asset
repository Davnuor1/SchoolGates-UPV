%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f125b745d539af443b514f6298b234dc, type: 3}
  m_Name: WiseManPracticesLocalization_ES
  m_EditorClassIdentifier: 
  vignettes:
  - backgroundImage: {fileID: 1251884205, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: Este es un lugar muy peligroso...
    placement: 0
  - backgroundImage: {fileID: -1636791454, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Cuando conocemos a alguien por primera vez, lo primero que hacemos es
      explorar qui\xE9n es y c\xF3mo es, si tenemos cosas en com\xFAn, si compartimos
      aficiones o valores... \xC9stos son los cimientos de una relaci\xF3n. Las personas
      empiezan a compartir detalles m\xE1s personales y a explorar los l\xEDmites
      de su conexi\xF3n."
    placement: 1
  - backgroundImage: {fileID: 1595807204, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Siempre hay algo en com\xFAn con todo el mundo, pero hay que acercarse
      a esa persona para descubrirlo. Cuanto m\xE1s compartas, m\xE1s probabilidades
      tendr\xE1s de entablar amistad. Y si os hac\xE9is amigos, habr\xE1s establecido
      un v\xEDnculo con esa persona."
    placement: 1
  - backgroundImage: {fileID: -1554177124, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Si todo va bien, ese v\xEDnculo puede durar toda la vida, \xA1y eso es
      estupendo! Pero siempre hay discusiones o desacuerdos que hay que resolver."
    placement: 1
  - backgroundImage: {fileID: 1245444621, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Conocer gente y estrechar lazos es incre\xEDble... Pero las relaciones
      pueden cambiar, pueden surgir dificultades y es importante saber c\xF3mo afrontarlas
      para construir conexiones pr\xF3speras y duraderas."
    placement: 2
  - backgroundImage: {fileID: 686330089, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Adem\xE1s, las relaciones pueden deteriorarse. A veces las personas cambian,
      o la vida nos lleva por caminos diferentes... Y entonces, los amigos o las
      parejas pueden sentirse cada vez m\xE1s desconectados, cada vez m\xE1s distantes...
      Hasta que la relaci\xF3n se acaba. Aunque decir adi\xF3s pueda ser doloroso,
      a veces es mejor dejar marchar a alguien..."
    placement: 2
  - backgroundImage: {fileID: 1657986904, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Pero una vez fue pac\xEDfico..."
    placement: 0
  - backgroundImage: {fileID: 533894941, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: Las criaturas de aspecto horrible que viste
    placement: 0
  - backgroundImage: {fileID: -243137760, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: fueron personas una vez, como nosotros.
    placement: 0
  - backgroundImage: {fileID: -713351420, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Pero luego cedieron a ser injustos con los dem\xE1s, les hicieron creer
      que pod\xEDan tener todo lo que quisieran."
    placement: 0
  - backgroundImage: {fileID: 5121602, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Perdieron toda la humanidad que hab\xEDa en ellos"
    placement: 0
  - backgroundImage: {fileID: -736844791, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "y ahora su alma est\xE1 perdida en alg\xFAn lugar..."
    placement: 0
  - backgroundImage: {fileID: -1772837806, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Para que el pantano sea seguro nuevamente, \_\_\_\_todo el mundo debe
      ser tratado con justicia, todo del mundo debe encontrar un lugar seguro...
      Te ense\xF1aremos lo que necesitas saber... para salvarlos\u2026 para luchar
      contra las desigualdades de una vez por todas\u2026 Trae a estas pobres almas
      aqu\xED con nosotros\u2026"
    placement: 0
  - backgroundImage: {fileID: 1657986904, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Para que el pantano sea seguro nuevamente, \_\_\_\_todo el mundo debe
      ser tratado con justicia, todo del mundo debe encontrar un lugar seguro...
      Te ense\xF1aremos lo que necesitas saber... para salvarlos\u2026 para luchar
      contra las desigualdades de una vez por todas\u2026 Trae a estas pobres almas
      aqu\xED con nosotros\u2026"
    placement: 5
  conflicts:
  - dialogues:
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "D\xE9jame presentarte a Eve, es una muy buena jugadora de f\xFAtbol\u2026"
      requiresResponse: 0
      responseOptions: []
    - characterName: Eve
      portrait: {fileID: 21300000, guid: 04816276ad4c8b64d80af5a19987b4b4, type: 3}
      text: "\xBFTe gusta el f\xFAtbol?"
      requiresResponse: 1
      responseOptions:
      - responseText: No
        responseFeedback: "Eve est\xE1 algo confusa ahora, has sido real, pero quiz\xE1
          no tan respetuosa o responsable... Creo que Eve ya no se siente c\xF3moda
          hablando contigo..-"
      - responseText: "No, pero me interesa tu experiencia. H\xE1blame m\xE1s de
          ti..."
        responseFeedback: "Eve ahora se siente bien porque percibe tu inter\xE9s
          y est\xE1 abierta a conocerte tambi\xE9n. Has sido real, responsable, receptiva
          y respetuosa. \xA1Genial!"
      - responseText: "\xA1S\xED, me gusta mucho!"
        responseFeedback: "Eve ahora se siente bien porque percibe tu inter\xE9s
          y est\xE1 abierta a conocerte tambi\xE9n. Has sido real, responsable, receptiva
          y respetuosa. \xA1Genial!"
    - characterName: Eve
      portrait: {fileID: 21300000, guid: 04816276ad4c8b64d80af5a19987b4b4, type: 3}
      text: "Quiz\xE1 podamos fundar un club de f\xFAtbol femenino"
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Imagina que t\xFA, Anna y tus amigas hab\xE9is estado planeando la inauguraci\xF3n
        del club de f\xFAtbol femenino durante mucho tiempo, pero en el \xFAltimo
        momento, no es posible seguir adelante con ello... En estos ejemplos, \xBFqui\xE9n
        crees que comunica de manera m\xE1s efectiva?"
      requiresResponse: 1
      responseOptions:
      - responseText: "Una de ellas critica a las otras por su opini\xF3n/actitud/comportamiento"
        responseFeedback: "Est\xE1n siendo un poco agresivas, \xBFno crees? Eso ocurre
          cuando alguien expresa sus pensamientos y sentimientos sin tener en cuenta
          a los dem\xE1s. La comunicaci\xF3n agresiva parece dominante y controladora,
          interrumpe con frecuencia a los dem\xE1s, invade el espacio personal y
          menosprecia a los dem\xE1s para transmitir su punto de vista. Esto provoca
          conflictos y resentimiento"
      - responseText: "Una de ellas ha estado descontenta con las actividades planeadas
          para la inauguraci\xF3n desde el principio, pero no dice nada sobre sus
          sentimientos por miedo a parecer una 'aguafiestas'..."
        responseFeedback: "Est\xE1n siendo un poco pasivas o sumisas, \xBFno crees?
          Eso sucede cuando alguien evita expresar sus pensamientos o sentimientos,
          a menudo por miedo al conflicto."
      - responseText: "Una de ellas afirma que la inauguraci\xF3n tiene que posponerse
          para otro d\xEDa, explicando las razones detr\xE1s de este cambio."
        responseFeedback: "El estilo de comunicaci\xF3n asertivo se caracteriza por
          mensajes claros y directos. Esto te permite expresar tus pensamientos y
          necesidades de manera respetuosa."
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: Gracias por tu opinion!
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 1
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Dime... \xBFHas tenido alguna vez un amigo as\xED?"
      requiresResponse: 1
      responseOptions:
      - responseText: "S\xED, tengo (o ten\xEDa) un amigo que siempre critica la
          forma de vestir del resto de amigos (\u201Cest\xE1s tan pasado de moda\u201D)
          o critica su forma de jugar a videojuegos... pero no est\xE1 dispuesto
          a explicar por qu\xE9 ni abierto al di\xE1logo."
        responseFeedback: 
      - responseText: 
        responseFeedback: 
      - responseText: "S\xED, tengo un amigo que nunca dice que no. Un amigo que
          nunca se queja aunque est\xE9 descontento con la situaci\xF3n..."
        responseFeedback: 
    requiresAllFeedback: 0
    isBranchingConflict: 1
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Ahora, escucha atentamente\u2026 encuentra tu silencio interior para
        poder ir m\xE1s all\xE1 de las palabras\u2026 \xBFQu\xE9 crees que est\xE1
        ocurriendo realmente?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Alguien que siempre est\xE1 criticando las decisiones que tomas..."
      requiresResponse: 1
      responseOptions:
      - responseText: Tal vez tenga miedo de algo...
        responseFeedback: "Muy bien, s\xED... no podemos estar seguros, pero puede
          que sea eso... Para ser bueno escuchando hay que prestar atenci\xF3n no
          s\xF3lo a las palabras, sino al significado subyacente de las mismas, tratar
          de entender qu\xE9 es lo realmente importante para esa persona."
      - responseText: "Tal vez simplemente no le gustamos\u2026"
        responseFeedback: "Muy bien, s\xED... no podemos estar seguros, pero puede
          que sea eso... Para ser bueno escuchando hay que prestar atenci\xF3n no
          s\xF3lo a las palabras, sino al significado subyacente de las mismas, tratar
          de entender qu\xE9 es lo realmente importante para esa persona."
      - responseText: "Tal vez le hayan hecho da\xF1o en el pasado y siga enfadado."
        responseFeedback: "Muy bien, s\xED... no podemos estar seguros, pero puede
          que sea eso... Para ser bueno escuchando hay que prestar atenci\xF3n no
          s\xF3lo a las palabras, sino al significado subyacente de las mismas, tratar
          de entender qu\xE9 es lo realmente importante para esa persona."
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "\xBFC\xF3mo podr\xEDas responderles?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Al que siempre est\xE1 criticando las decisiones que tomas..."
      requiresResponse: 1
      responseOptions:
      - responseText: "Creo que deber\xEDas ser menos brusco con la gente, \xA1no
          es agradable!"
        responseFeedback: Bueno, tu mensaje es claro pero tal vez no muy compasivo
          con esa persona.
      - responseText: "Pues a partir de ahora criticar\xE9 todo lo que digas!"
        responseFeedback: "Quiz\xE1 act\xFAas demasiado impulsivamente, \xA1tu comportamiento
          es el mismo que criticas!"
      - responseText: "Tengo la impresi\xF3n de que algo te reconcome. \xBFQuieres
          hablar de ello?"
        responseFeedback: "Genial, est\xE1s siendo claro/a pero compasivo/a. Para
          ser respetuoso, piensa siempre en c\xF3mo te gustar\xEDa que te lo dijeran
          a ti..."
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Lo que acabas de practicar es lo que llamamos el ABC de la buena comunicaci\xF3n.
        No importa en qu\xE9 etapa de la relaci\xF3n te encuentres, es importante
        comunicarse de la manera correcta para que todos se sientan seguros..."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Now, listen carefully\u2026 find your inner silence to be able to go
        beyond words\u2026 What do you think is really happening?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "The one who is unhappy but says nothing\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: Maybe is afraid of being rejected by the other friends
        responseFeedback: "very well, yes... we can't be sure, but that may be it\u2026
          To be a good listener you have to pay attention not only to the words,
          but the underlying meaning of them, try to understand what is really important
          for this person."
      - responseText: Maybe needs to be asked to be able to express themself
        responseFeedback: "very well, yes... we can't be sure, but that may be it\u2026
          To be a good listener you have to pay attention not only to the words,
          but the underlying meaning of them, try to understand what is really important
          for this person."
      - responseText: "Maybe doesn\u2019t think their friends will appreciate their
          thoughts"
        responseFeedback: "very well, yes... we can't be sure, but that may be it\u2026
          To be a good listener you have to pay attention not only to the words,
          but the underlying meaning of them, try to understand what is really important
          for this person."
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: How can you respond to them?
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Al que no est\xE1 contento/a con la actividad prevista pero no dice
        nada..."
      requiresResponse: 1
      responseOptions:
      - responseText: "Nunca dices lo que tienes en mente, lo que realmente piensas.
          \xA1Es muy dif\xEDcil ser tu amigo/a!"
        responseFeedback: "Bueno, tu mensaje es claro pero quiz\xE1s no muy compasivo
          con esa persona."
      - responseText: Eres un amigo muy querido, por favor, no pienses que no queremos
          escuchar tus opiniones. Tus opiniones son importantes y queremos conocerlas.
        responseFeedback: "Genial, est\xE1s siendo claro/a pero compasivo/a. Para
          ser respetuoso, piensa siempre en c\xF3mo te gustar\xEDa que te lo dijeran
          a ti..."
      - responseText: "A veces pienso que no tienes criterio propio. \xBFAlguna vez
          opinas sobre algo?"
        responseFeedback: Bueno, tu mensaje es claro pero tal vez no muy compasivo
          con esa persona.
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Lo que acabas de practicar es lo que llamamos el ABC de la buena comunicaci\xF3n.
        No importa en qu\xE9 etapa de la relaci\xF3n te encuentres, es importante
        comunicarse de la manera correcta para que todos se sientan seguros..."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  conflict1Concepts:
  - term: Respetuoso/a
    description: "Significa intentar comprender y mostrar inter\xE9s por la experiencia
      y la perspectiva de los dem\xE1s, aunque no est\xE9s de acuerdo."
  - term: Real
    description: "Significa ser aut\xE9ntico/a y sincero/a, no ser falso. Expresar
      tus verdaderas creencias, aunque puedan resultar desafiantes, decepcionantes
      o inc\xF3modas para los dem\xE1s."
  - term: Responsable
    description: "Significa ser responsable de tus actos y sentimientos. No culpar
      a los dem\xE1s de tus problemas."
  - term: Receptivo/a
    description: "Esto significa evitar reacciones impulsivas. Responder con compasi\xF3n
      y comprensi\xF3n."
  conflict3Concepts:
  - term: Buen escuchador/a
    description: " La escucha activa es la pr\xE1ctica de prestar toda tu atenci\xF3n
      a la persona que te habla, sin juzgarla. Para ser bueno escuchando hay que
      guardar un silencio interior que te permita recibir con claridad el mensaje
      de la otra persona. Ten cuidado cuando la otra persona te est\xE9 hablando,
      ve m\xE1s all\xE1 de las palabras y haz lo posible por buscar el significado.
      \xBFQu\xE9 es importante para esa persona?\r\n"
  - term: Claro/a
    description: "Mensajes breves: Haz que tu mensaje sea lo m\xE1s breve posible,
      aunque completo. Un buen comunicador intenta transmitir su punto de vista de
      forma eficaz, con detalles pero sin datos innecesarios. Para ser claro/a, piensa
      en lo realmente importante de lo que quieres decir y dilo de la forma m\xE1s
      concisa posible"
  - term: "Compasi\xF3n"
    description: "La comunicaci\xF3n emp\xE1tica se caracteriza por comprender y
      compartir los sentimientos de los dem\xE1s. Esta comunicaci\xF3n centrada en
      las personas da prioridad a construir y cuidar las relaciones. Para ser respetuoso/a,
      piensa en c\xF3mo te gustar\xEDa que se dirigieran a ti."
