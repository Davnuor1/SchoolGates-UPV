%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f125b745d539af443b514f6298b234dc, type: 3}
  m_Name: WiseManPracticesLocalization_DE
  m_EditorClassIdentifier: 
  vignettes:
  - backgroundImage: {fileID: 1251884205, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Dies ist ein sehr gef\xE4hrlicher Ort..."
    placement: 0
  - backgroundImage: {fileID: -1636791454, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Wenn wir jemanden zum ersten Mal treffen, erkunden wir zuerst, wer und
      wie diese Person ist, ob wir gemeinsame Interessen oder Werte haben... Dies
      sind die Grundlagen, die Bausteine einer Beziehung. Personen beginnen, mehr
      pers\xF6nliche Details zu teilen und die Grenzen ihrer Verbindung zu testen."
    placement: 1
  - backgroundImage: {fileID: 1595807204, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Es gibt immer etwas, das man mit jedem gemeinsam hat, aber man muss sich
      dieser Person n\xE4hern, um es zu entdecken. Je mehr man teilt, desto wahrscheinlicher
      ist es, dass man Freunde wird. Und wenn man Freunde wird, hat man eine Bindung
      zu dieser Person aufgebaut."
    placement: 1
  - backgroundImage: {fileID: -1554177124, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Wenn alles gut geht, kann diese Bindung ein Leben lang halten, und das
      ist gro\xDFartig! Aber es gibt immer Streitigkeiten oder Meinungsverschiedenheiten,
      die gel\xF6st werden m\xFCssen."
    placement: 1
  - backgroundImage: {fileID: 1245444621, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Menschen zu treffen und Bindungen einzugehen ist gro\xDFartig... Aber
      Beziehungen k\xF6nnen sich \xE4ndern, Schwierigkeiten k\xF6nnen auftreten und
      es ist wichtig zu wissen, wie man damit umgeht, um erfolgreiche und dauerhafte
      Verbindungen aufzubauen."
    placement: 2
  - backgroundImage: {fileID: 686330089, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Auch Beziehungen k\xF6nnen sich verschlechtern. Manchmal \xE4ndern sich
      Menschen oder das Leben f\xFChrt uns auf unterschiedliche Wege... Und dann
      k\xF6nnen sich Freunde oder Paare immer mehr entfremden, immer distanzierter
      werden... Bis die Beziehung endet. Auch wenn das Abschiednehmen schmerzhaft
      sein kann, ist es manchmal das Beste, jemanden gehen zu lassen..."
    placement: 2
  - backgroundImage: {fileID: 1657986904, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: Aber einst war es friedlich...
    placement: 0
  - backgroundImage: {fileID: 533894941, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: Die abscheulichen Kreaturen, die du gesehen hast
    placement: 0
  - backgroundImage: {fileID: -243137760, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: waren einst Menschen, wie wir.
    placement: 0
  - backgroundImage: {fileID: -713351420, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Dann gaben sie sich der Ungerechtigkeit hin, sie wurden dazu gebracht
      zu glauben, dass sie alles haben k\xF6nnten, was sie wollten."
    placement: 0
  - backgroundImage: {fileID: 5121602, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: Sie haben ihre ganze Menschlichkeit verloren
    placement: 0
  - backgroundImage: {fileID: -736844791, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: und jetzt ist ihre Seele irgendwo verloren...
    placement: 0
  - backgroundImage: {fileID: -1772837806, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Damit der Sumpf wieder sicher wird, muss jeder gerecht behandelt werden,
      jeder verdient es, einen sicheren Ort zu finden... Wir werden Dir beibringen,
      was Du wissen musst... um sie zu retten\u2026 um Ungerechtigkeiten ein f\xFCr
      alle Mal zu bek\xE4mpfen... Bringe diese armen Seelen zu uns..."
    placement: 0
  - backgroundImage: {fileID: 1657986904, guid: 3814edea3e5849f48ba217cf4bee6dd3, type: 3}
    text: "Damit der Sumpf wieder sicher wird, muss jeder gerecht behandelt werden,
      jeder verdient es, einen sicheren Ort zu finden... Wir werden Dir beibringen,
      was Du wissen musst... um sie zu retten\u2026 um Ungerechtigkeiten ein f\xFCr
      alle Mal zu bek\xE4mpfen... Bringe diese armen Seelen zu uns..."
    placement: 5
  conflicts:
  - dialogues:
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Lass mich Dir Eve vorstellen, sie ist eine sehr gute Fu\xDFballspielerin\u2026"
      requiresResponse: 0
      responseOptions: []
    - characterName: Eve
      portrait: {fileID: 21300000, guid: 04816276ad4c8b64d80af5a19987b4b4, type: 3}
      text: "Magst Du Fu\xDFball?"
      requiresResponse: 1
      responseOptions:
      - responseText: Nein
        responseFeedback: "Eve ist jetzt ein bisschen verwirrt, Du warst ehrlich,
          aber vielleicht nicht so respektvoll oder verantwortungsbewusst... Ich
          denke, Eve f\xFChlt sich nicht mehr wohl, mit dir zu sprechen..."
      - responseText: "Nein, aber ich interessiere mich f\xFCr Deine Erfahrungen.
          Erz\xE4hl mir mehr \xFCber Dich..."
        responseFeedback: "Eve f\xFChlt sich jetzt gut, weil sie Dein Interesse bemerkt
          und bereit ist, Dich auch kennenzulernen. Du warst ehrlich, verantwortungsbewusst,
          reaktionsf\xE4hig und respektvoll. Gro\xDFartig!"
      - responseText: Ja, ich mag es sehr!
        responseFeedback: "Eve f\xFChlt sich jetzt gut, weil sie Dein Interesse bemerkt
          und bereit ist, Dich auch kennenzulernen. Du warst ehrlich, verantwortungsbewusst,
          reaktionsf\xE4hig und respektvoll. Gro\xDFartig!"
    - characterName: Eve
      portrait: {fileID: 21300000, guid: 04816276ad4c8b64d80af5a19987b4b4, type: 3}
      text: "Vielleicht k\xF6nnen wir einen Frauenfu\xDFballverein gr\xFCnden."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Stell Dir vor, dass Du, Anna und Deine Freunde die Er\xF6ffnung des
        Frauenfu\xDFballclubs schon lange geplant habt, aber in letzter Minute ist
        es nicht m\xF6glich, weiterzumachen ... Wer kommuniziert Deiner Meinung nach
        in diesen Beispielen besser?"
      requiresResponse: 1
      responseOptions:
      - responseText: Einer von ihnen kritisiert die anderen wegen ihrer Meinung/Einstellung/Verhalten.
        responseFeedback: "Sie sind ein bisschen aggressiv, findest Du nicht? Das
          passiert, wenn jemand seine Gedanken und Gef\xFChle ohne R\xFCcksicht auf
          andere ausdr\xFCckt. Aggressive Kommunikation erscheint dominant und kontrollierend,
          unterbricht oft andere, dringt in den pers\xF6nlichen Raum ein und erniedrigt
          andere, um ihren Standpunkt klarzumachen. Dies f\xFChrt zu Konflikten und
          Groll."
      - responseText: "Einer von ihnen ist von Anfang an unzufrieden mit den geplanten
          Aktivit\xE4ten f\xFCr die Er\xF6ffnung, sagt aber nichts \xFCber seine
          Gef\xFChle aus Angst, als 'Spielverderber' zu erscheinen..."
        responseFeedback: "Sie sind ein bisschen passiv oder kleinlaut, findest Du
          nicht? Das passiert, wenn jemand vermeidet, seine Gedanken oder Gef\xFChle
          auszudr\xFCcken, oft aus Angst vor Konflikten."
      - responseText: "Einer von ihnen erkl\xE4rt, dass die Er\xF6ffnung auf einen
          anderen Tag verschoben werden muss und erl\xE4utert die Gr\xFCnde f\xFCr
          diese \xC4nderung."
        responseFeedback: "Dieser Kommunikationsstil ist durch klare, direkte Botschaften
          gekennzeichnet. Dies erm\xF6glicht es Dir, Deine Gedanken und Bed\xFCrfnisse
          auf respektvolle Weise auszudr\xFCcken."
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Vielen Dank f\xFCr Ihre Meinung!"
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 1
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: Sag mir... Hattest Du jemals einen Freund wie diesen?
      requiresResponse: 1
      responseOptions:
      - responseText: "Ja, ich habe (oder hatte) einen Freund, der immer kritisiert,
          wie die anderen Freunde sich kleiden, wenn sie ausgehen (\"Du bist so aus
          der Mode\") oder ihre Gaming-F\xE4higkeiten kritisiert... aber nicht bereit
          ist, zu erkl\xE4ren warum oder offen f\xFCr ein Gespr\xE4ch ist."
        responseFeedback: 
      - responseText: 
        responseFeedback: 
      - responseText: "Ja, ich habe einen Freund, der niemals Nein sagt. Ein Freund,
          der sich nie beschwert, auch wenn er mit der Situation unzufrieden ist\u2026"
        responseFeedback: 
    requiresAllFeedback: 0
    isBranchingConflict: 1
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Jetzt h\xF6r gut zu\u2026 finde Deine innere Stille, um \xFCber die
        Worte hinauszugehen\u2026 Was denkst Du, passiert wirklich?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Eine Person, die immer Deine Entscheidungen kritisiert,\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: "Vielleicht hat sie vor etwas Angst\u2026"
        responseFeedback: "Sehr gut, ja\u2026 wir k\xF6nnen uns nicht sicher sein,
          aber das k\xF6nnte es sein\u2026 Um ein guter Zuh\xF6rer zu sein, musst
          Du nicht nur auf die Worte achten, sondern auch auf deren zugrunde liegende
          Bedeutung, versuche zu verstehen, was dieser Person wirklich wichtig ist."
      - responseText: "Vielleicht mag sie uns einfach nicht\u2026"
        responseFeedback: "Sehr gut, ja\u2026 wir k\xF6nnen uns nicht sicher sein,
          aber das k\xF6nnte es sein\u2026 Um ein guter Zuh\xF6rer zu sein, musst
          Du nicht nur auf die Worte achten, sondern auch auf deren zugrunde liegende
          Bedeutung, versuche zu verstehen, was dieser Person wirklich wichtig ist."
      - responseText: "Vielleicht wurde sie in der Vergangenheit verletzt und ist
          immer noch w\xFCtend."
        responseFeedback: "Sehr gut, ja\u2026 wir k\xF6nnen uns nicht sicher sein,
          aber das k\xF6nnte es sein\u2026 Um ein guter Zuh\xF6rer zu sein, musst
          Du nicht nur auf die Worte achten, sondern auch auf deren zugrunde liegende
          Bedeutung, versuche zu verstehen, was dieser Person wirklich wichtig ist."
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: Wie kannst Du ihnen antworten?
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Demjenigen, der immer Deine Entscheidungen kritisiert,\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: "Ich denke, Du solltest weniger aggressiv gegen\xFCber anderen
          sein, das ist nicht nett!"
        responseFeedback: "Nun, Deine Botschaft ist klar, aber vielleicht nicht sehr
          mitf\xFChlend gegen\xFCber dieser Person."
      - responseText: Nun, ab jetzt werde ich alles kritisieren, was Du sagst!
        responseFeedback: Vielleicht handelst Du zu impulsiv, Dein Verhalten ist
          genau das, was Du kritisierst!
      - responseText: "Ich habe den Eindruck, dass Dich etwas belastet. M\xF6chtest
          Du dar\xFCber sprechen?"
        responseFeedback: "Gro\xDFartig, Du bist klar, aber nicht mitf\xFChlend.
          Um respektvoll zu sein, denke immer daran, wie Du es gesagt bekommen m\xF6chtest\u2026"
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Was Du gerade ge\xFCbt hast, nennen wir das ABC der guten Kommunikation.
        Unabh\xE4ngig davon, in welcher Phase einer Beziehung Du Dich befindest,
        ist es entscheidend, auf die richtige Weise zu kommunizieren, damit sich
        alle sicher f\xFChlen...."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  - dialogues:
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Jetzt h\xF6r gut zu\u2026 finde Deine innere Stille, um \xFCber die
        Worte hinauszugehen\u2026 Was denkst Du, passiert wirklich?"
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Derjenige, der unzufrieden ist, aber nichts sagt\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: Hat vielleicht Angst, von den anderen Freunden abgelehnt zu
          werden.
        responseFeedback: "Sehr gut, ja\u2026 wir k\xF6nnen uns nicht sicher sein,
          aber das k\xF6nnte es sein\u2026 Um ein guter Zuh\xF6rer zu sein, musst
          Du nicht nur auf die Worte achten, sondern auch auf deren zugrunde liegende
          Bedeutung, versuche zu verstehen, was dieser Person wirklich wichtig ist."
      - responseText: "Muss vielleicht gefragt werden, um sich \xE4u\xDFern zu k\xF6nnen."
        responseFeedback: "Sehr gut, ja\u2026 wir k\xF6nnen uns nicht sicher sein,
          aber das k\xF6nnte es sein\u2026 Um ein guter Zuh\xF6rer zu sein, musst
          Du nicht nur auf die Worte achten, sondern auch auf deren zugrunde liegende
          Bedeutung, versuche zu verstehen, was dieser Person wirklich wichtig ist."
      - responseText: "Denkt vielleicht, dass die eigenen Freunde seine Gedanken
          nicht zu sch\xE4tzen wissen."
        responseFeedback: "Sehr gut, ja\u2026 wir k\xF6nnen uns nicht sicher sein,
          aber das k\xF6nnte es sein\u2026 Um ein guter Zuh\xF6rer zu sein, musst
          Du nicht nur auf die Worte achten, sondern auch auf deren zugrunde liegende
          Bedeutung, versuche zu verstehen, was dieser Person wirklich wichtig ist."
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: Wie kannst Du ihnen antworten?
      requiresResponse: 0
      responseOptions: []
    - characterName: Wise Man
      portrait: {fileID: 21300000, guid: 8c68f6b9ce088b641a9b60416829e8d6, type: 3}
      text: "Demjenigen, der mit der geplanten Aktivit\xE4t unzufrieden ist, aber
        nichts sagt\u2026"
      requiresResponse: 1
      responseOptions:
      - responseText: Du sagst nie, was Du denkst, was Du wirklich meinst. Es ist
          sehr schwierig, Dein Freund zu sein!
        responseFeedback: "Nun, Deine Botschaft ist klar, aber vielleicht nicht sehr
          mitf\xFChlend gegen\xFCber dieser Person."
      - responseText: "Du bist ein lieber Freund von uns, bitte denke nicht, dass
          wir Deine Meinungen nicht h\xF6ren wollen. Deine Meinungen sind wichtig
          und wir wollen sie wissen."
        responseFeedback: "Gro\xDFartig, Du bist klar, aber auch mitf\xFChlend. Um
          respektvoll zu sein, denke immer daran, wie Du es gesagt bekommen m\xF6chtest\u2026"
      - responseText: Manchmal denke ich, dass Du keine eigene Meinung hast. Hast
          Du jemals eine Meinung zu etwas?
        responseFeedback: "Nun, Deine Botschaft ist klar, aber vielleicht nicht sehr
          mitf\xFChlend gegen\xFCber dieser Person."
    - characterName: Wise Woman
      portrait: {fileID: 21300000, guid: 5fb8cbc286be4a5429407a23e048c481, type: 3}
      text: "Was Du gerade ge\xFCbt hast, nennen wir das ABC der guten Kommunikation.
        Unabh\xE4ngig davon, in welcher Phase einer Beziehung Du Dich befindest,
        ist es entscheidend, auf die richtige Weise zu kommunizieren, damit sich
        alle sicher f\xFChlen...."
      requiresResponse: 0
      responseOptions: []
    requiresAllFeedback: 0
    isBranchingConflict: 0
  conflict1Concepts:
  - term: Respektvoll
    description: Das bedeutet, zu versuchen, die Erfahrungen und Perspektiven anderer
      zu verstehen und Interesse daran zu zeigen, auch wenn Du anderer Meinung bist.
  - term: Ehrlich
    description: "Das bedeutet, authentisch und aufrichtig zu sein, nicht falsch.
      Deine wahren \xDCberzeugungen auszudr\xFCcken, auch wenn sie f\xFCr andere
      herausfordernd, entt\xE4uschend oder unangenehm sein k\xF6nnen. \r\n"
  - term: Verantwortungsbewusst
    description: "Das bedeutet, f\xFCr Deine Handlungen und Gef\xFChle Verantwortung
      zu \xFCbernehmen. Nicht andere f\xFCr Deine Probleme verantwortlich zu machen."
  - term: "Reaktionsf\xE4hig"
    description: "Das bedeutet, impulsive Reaktionen zu vermeiden. Mit Mitgef\xFChl
      und Verst\xE4ndnis zu antworten.\r\n"
  conflict3Concepts:
  - term: "Guter zuh\xF6rer"
    description: "Aktives Zuh\xF6ren bedeutet, der Person, die mit Dir spricht, Deine
      volle Aufmerksamkeit zu schenken und nicht zu urteilen. Um ein guter Zuh\xF6rer
      zu sein, musst Du eine innere Stille schaffen, damit die Botschaft der anderen
      Person klar empfangen werden kann. Achte sorgf\xE4ltig darauf, wenn die andere
      Person mit Dir spricht, gehe \xFCber die Worte hinaus und bem\xFChe Dich, den
      Sinn zu erfassen. Was ist dieser Person wichtig?"
  - term: Klar
    description: "Kurze Nachrichten: Halte Deine Nachricht so kurz wie m\xF6glich,
      aber vollst\xE4ndig. Ein guter Kommunikator versucht, den Punkt effektiv zu
      vermitteln, mit Details, aber ohne unn\xF6tige Details. Um klar zu sein, denke
      dar\xFCber nach, was wirklich wichtig ist bei dem, was Du sagen m\xF6chtest,
      und sage es so pr\xE4gnant wie m\xF6glich."
  - term: "Mitgef\xFChl"
    description: "Empathische Kommunikation zeichnet sich dadurch aus, dass man die
      Gef\xFChle anderer versteht und teilt. Diese auf den Menschen ausgerichtete
      Kommunikation legt den Schwerpunkt auf den Aufbau und die Pflege von Beziehungen.
      Um respektvoll zu sein, denke daran, wie Du selbst angesprochen werden m\xF6chtest."
