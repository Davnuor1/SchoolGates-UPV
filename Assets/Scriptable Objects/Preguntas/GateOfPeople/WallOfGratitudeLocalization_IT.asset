%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05a61ef5f9b69e544ba75093eb10ed3d, type: 3}
  m_Name: WallOfGratitudeLocalization_IT
  m_EditorClassIdentifier: 
  upperTextMain: "C\u2019\xE8 sempre qualcosa per cui essere grati\u2026 pensa a
    ci\xF2 per cui sei grato e metti la pietra nel muro\u2026"
  upperTextStoneView: Vuoi aggiungere questa pietra al muro della gratitudine?
  upperTextGratitudeWall: "Questo \xE8 il tuo muro della gratitudine"
  finishButton: Finitura
  addToWallButton: Aggiungi alla bacheca
  backButton: Torna indietro
  nextButton: Avanti
  previousButton: Precedente
  gratitudeWallTitle: Bacheca della gratitudine
  stones:
  - title: 'Amici e relazioni '
    descriptions:
    - "Avere amici fedeli/Avere un migliore amico\r"
    - "Essere supportato e amato dalle persone a cui tengo\r"
    - "Avere un partner che mi ama e mi sostiene\r"
    - Divertirmi con i miei amici
  - title: Famiglia
    descriptions:
    - Avere una famiglia/fratelli premurosi e solidali
    - Sentire di poter chiedere aiuto ed essere aiutato
    - Essere ascoltato e riconosciuto
    - Condividere ricordi ed esperienze felici
  - title: "Libert\xE0 e sicurezza"
    descriptions:
    - Essere in grado di esprimere i miei sentimenti e pensieri
    - Avere sostegno quando sei stato discriminato o escluso
    - Vivere in pace e sicurezza
  - title: Bisogni primari
    descriptions:
    - Avere cibo da mangiare
    - Avere una casa sicura
    - Avere accesso all'acqua pulita
  - title: Istruzione
    descriptions:
    - poter andare a scuola e imparare cose nuove
    - Avere buoni insegnanti e mentori
    - Essere in grado di crescere e sviluppare il mio potenziale
  - title: Tempo
    descriptions:
    - Poter avere tempo libero
    - Avere momenti per me stesso
    - "Avere opportunit\xE0 di autoriflessione"
  - title: Risultati personali
    descriptions:
    - Poter sognare il mio futuro
    - "Aver affrontato e superato difficolt\xE0"
    - Realizzare i miei obiettivi
  - title: Salute e benessere
    descriptions:
    - Essere in buona salute mentale e fisica
    - Avere accesso a una buona assistenza sanitaria
    - Sentirsi soddisfatto e realizzato della mia vita
  - title: Natura
    descriptions:
    - Accesso all'aria fresca e ad un ambiente pulito
    - Godere di uno splendido paesaggio, stare nella natura
  - title: Tecnologia
    descriptions:
    - Libero accesso alle informazioni
    - Avere dispositivi digitali
